---
// The map atlas. This used to be the homepage; the homepage is the guide now, so every one
// of the 1,195 map links lives here instead (DECISIONS.md -- homepage is no longer the atlas).
import Base from "../../layouts/Base.astro";
import { mapUrl } from "../../Url";
import mapsData from "../../../data/generated/maps.json";
import manifestData from "../../../data/manifest/map-manifest.json";
import { titleOf, slugOf } from "../../Names";

const maps: any[] = (mapsData as any).maps;
const have = new Set((manifestData as any).maps.map((m: any) => m.map_id));

// Sevii is split out of Kanto: 160 maps, its own Seagallop ferry network and three dedicated
// region-map layouts in the game (DECISIONS.md 19). Folding it into a single Kanto list
// would bury it.
const SECTIONS = [
  {
    key: "kanto",
    label: "Kanto",
    test: (m: any) => m.region === "kanto" && !m.subregion,
  },
  { key: "sevii", label: "Sevii Islands", test: (m: any) => !!m.subregion },
  { key: "johto", label: "Johto", test: (m: any) => m.region === "johto" },
  { key: "hoenn", label: "Hoenn", test: (m: any) => m.region === "hoenn" },
  { key: "shared", label: "Shared", test: (m: any) => m.region === "shared" },
];

const live = maps.filter((m) => have.has(m.id));
const grouped = SECTIONS.map((s) => ({
  ...s,
  maps: live
    .filter(s.test)
    .sort((a, b) => titleOf(a.id).localeCompare(titleOf(b.id)))
    .map((m: any) => ({
      href: mapUrl(m.id),
      title: titleOf(m.id),
      // The filter matches the printed name and the slug, so "route1" finds Route 1.
      search: `${titleOf(m.id)} ${slugOf(m.id)} ${s.label}`.toLowerCase(),
      // Name and slug on their own, because a SUBSTRING match cannot tell "route1" the map
      // from "route1" inside route10 and route11. Ranking needs the two fields whole; the
      // blob above cannot answer "does this START with the query" once the region label is
      // concatenated onto it.
      exact: `${titleOf(m.id)}\n${slugOf(m.id)}`.toLowerCase(),
    })),
})).filter((s) => s.maps.length > 0);
---

<Base
  title="All Maps"
  eyebrow="Atlas"
  subtitle={`${live.length.toLocaleString("en-US")} maps across ${grouped.length} sections, every one with an aerial view.`}
>
  <p class="lede">
    Every map in the game that renders an aerial view, grouped by region. Each
    page carries the wild encounters, trainers, items and exits for that map.
    Type a name to filter.
  </p>

  <input
    id="q"
    type="search"
    placeholder="Route 1 · viridian · cave · Sevii"
    autocomplete="off"
  />
  <p id="count" class="count"></p>

  {
    grouped.map((s) => (
      <section class="mapsec" data-sec>
        <h2 id={s.key}>
          {s.label} <span class="count-badge">{s.maps.length}</span>
        </h2>
        <ul class="grid-links">
          {s.maps.map((m) => (
            <li data-s={m.search} data-n={m.exact}>
              <a href={m.href}>{m.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p id="none" class="empty" hidden>No map matches that.</p>

  <style>
    .lede {
      max-width: 68ch;
    }
    #q {
      width: 100%;
      max-width: 34rem;
      font: 1rem/1.4 var(--body);
      background: var(--panel);
      color: var(--fg);
      border: 1px solid var(--rule-hot);
      padding: 0.55rem 0.8rem;
      margin: 0.5rem 0 0.4rem;
    }
    #q:focus {
      outline: none;
      border-color: var(--accent);
    }
    .count {
      color: var(--fg-faint);
      font-size: 0.85rem;
      margin: 0 0 1rem;
    }
    .count-badge {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--fg-faint);
      letter-spacing: 0;
    }
    .empty {
      color: var(--fg-dim);
    }
  </style>

  <script>
    // Same plain-DOM filter the Pokédex index uses: no index to build, no dependency.
    const q = document.getElementById("q") as HTMLInputElement;
    const count = document.getElementById("count")!;
    const none = document.getElementById("none")!;
    const secs = [...document.querySelectorAll<HTMLElement>("[data-sec]")].map(
      (sec) => ({
        sec,
        badge: sec.querySelector<HTMLElement>(".count-badge")!,
        list: sec.querySelector<HTMLElement>("ul")!,
        items: [...sec.querySelectorAll<HTMLElement>("li[data-s]")],
      }),
    );

    // WHY THE HITS ARE RANKED AND NOT JUST FILTERED. The match is a substring, so "route1"
    // is a hit on Route 1, Route 10, Route 11 and every interior of theirs -- 101 of them,
    // for a query the reader typed meaning one map. Nothing was wrong with the matching:
    // route10 really does contain "route1" and hiding it would be worse. What was wrong is
    // that the one map they asked for sat somewhere in an alphabetical list of a hundred.
    //
    // So the substring stays and the ORDER carries the precision: the exact name or slug
    // first, then the ones that start with the query, then everything else, each rank
    // holding its alphabetical order. "route1" now opens with Route 1.
    //
    // Reordered in the DOM rather than with CSS `order`. This is an accessibility fix and
    // `order` moves the paint without moving the tab sequence, which would hand a keyboard
    // user the hundred in the old order under a visibly re-sorted list -- WCAG 1.3.2, and
    // exactly the kind of "looks fixed" this repo keeps catching.
    const rankOf = (li: HTMLElement, t: string) => {
      const [name = "", slug = ""] = (li.dataset.n || "").split("\n");
      if (name === t || slug === t) return 0;
      if (name.startsWith(t) || slug.startsWith(t)) return 1;
      return 2;
    };
    const total = secs.reduce((n, s) => n + s.items.length, 0);
    const fmt = (n: number) => n.toLocaleString("en-US");
    const show = (n: number) =>
      (count.textContent = `${fmt(n)} of ${fmt(total)} shown`);
    show(total);

    q.addEventListener("input", () => {
      const t = q.value.trim().toLowerCase();
      let n = 0;
      for (const { sec, badge, list, items } of secs) {
        let k = 0;
        const hits: HTMLElement[] = [];
        for (const li of items) {
          const hit = !t || li.dataset.s!.includes(t);
          li.hidden = !hit;
          if (hit) {
            k++;
            hits.push(li);
          }
        }
        // Cleared query: put the section back exactly as it was rendered. Sorting the whole
        // set by rank 2 would be stable, but "restore" is a stronger promise than "stable".
        if (!t) {
          for (const li of items) list.appendChild(li);
        } else {
          const at = new Map(items.map((li, i) => [li, i]));
          hits.sort(
            (a, b) => rankOf(a, t) - rankOf(b, t) || at.get(a)! - at.get(b)!,
          );
          for (const li of hits) list.appendChild(li);
        }
        // A section with nothing left in it takes its heading with it, so the page does
        // not fill up with empty region titles.
        sec.hidden = k === 0;
        badge.textContent = String(k);
        n += k;
      }
      none.hidden = n > 0;
      show(n);
    });
  </script>
</Base>
