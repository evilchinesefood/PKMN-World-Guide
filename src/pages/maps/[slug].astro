---
import Base from "../../layouts/Base.astro";
import MapViewer from "../../components/MapViewer.astro";
import EncounterTable from "../../components/EncounterTable.astro";
import Spoiler from "../../components/Spoiler.astro";
import Fold from "../../components/Fold.astro";
import { url, mapUrl } from "../../Url";
import { slugOf, titleOf, prettyConst, gateLabel } from "../../Names";
import { markersOf, isItem, isTrainer } from "../../Markers";
import { chapterEntries, slugOfPath } from "../../Chapters";
import progression from "../../../data/generated/progression.json";
import TrainerCard from "../../components/TrainerCard.astro";
import mapsData from "../../../data/generated/maps.json";
import manifestData from "../../../data/manifest/map-manifest.json";
import encData from "../../../data/generated/encounters.json";
import trainerData from "../../../data/generated/trainers.json";
import battle from "../../../data/generated/battledata.json";

const maps: any[] = (mapsData as any).maps;
const manifest = new Map<string, any>(
  (manifestData as any).maps.map((m: any) => [m.map_id, m]),
);
const encs: any[] = (encData as any).encounters;
const B = battle as any;

// Every SPECIES_*/MOVE_* is resolved once here from battledata.json rather than each card
// re-deriving it. BattleData.py asserts full coverage, so a miss is a build failure there,
// not a raw constant leaking onto a published page.
const dex = (k: string) => B.species?.[k]?.name ?? k;
const move = (k: string) => B.moves?.[k]?.name ?? k;
// types is {primary, secondary}; the two are equal on single-type species, so dedupe.
const typesOf = (k: string) => {
  const t = B.species?.[k]?.types;
  if (!t) return [];
  return [...new Set([t.primary, t.secondary].filter(Boolean))].map(
    (x: any) => B.types?.[x]?.name ?? x,
  );
};
const ability = (k: string | null) =>
  k ? (B.abilities?.[k]?.name ?? k) : null;
const itemName = (k: string | null) => (k ? (B.items?.[k]?.name ?? k) : null);

export async function getStaticPaths() {
  const ms: any[] = (await import("../../../data/generated/maps.json")).default
    .maps;
  const mf = new Map<string, any>(
    (await import("../../../data/manifest/map-manifest.json")).default.maps.map(
      (m: any) => [m.map_id, m],
    ),
  );
  const { slugOf } = await import("../../Names");
  return ms
    .filter((m) => mf.has(m.id))
    .map((m) => ({ params: { slug: slugOf(m.id) } }));
}

const { slug } = Astro.params;
const m = maps.find((x) => slugOf(x.id) === slug)!;
const img = manifest.get(m.id)!;

// 125 maps carry more than one encounter entry, and for most of them the variants are
// byte-identical -- Route 1's FireRed and LeafGreen tables are the same table. Printing both
// is noise, so group by content and name the variants once. Where they genuinely differ
// (Altering Cave) every distinct table still gets shown. See DATA-AUDIT.md 4.4 / Q7.
// `live: false` marks the *_LeafGreen tables, which the generator compiles out of the
// shipped EMERALD build entirely. Publishing them would present 132 dead tables as real.
const encRaw = encs.filter((e: any) => e.map === m.id && e.live !== false);
const encGroups = new Map<string, { labels: string[]; methods: any }>();
for (const e of encRaw) {
  const k = JSON.stringify(e.methods);
  const hit = encGroups.get(k);
  if (hit) hit.labels.push(e.base_label);
  else encGroups.set(k, { labels: [e.base_label], methods: e.methods });
}
const enc = [...encGroups.values()];

// The "Wild Pokémon" heading carries NO number, deliberately. It briefly carried a count of
// distinct species, and that number disagreed with the sum of its own child folds on 330 of
// the 331 pages that have one -- the children count table rows, and one species occupies
// several slots and several tables (Altering Cave: 10 species, 73 rows). Both numbers are
// true and neither is the other, so a reader who opened "(6)" and counted 13 had every
// reason to stop trusting every count on the site. The child folds each carry their own row
// count, which is the number that can be checked by opening it. See DECISIONS 39.

// encounters.json strips the _mons suffix, so these key on the bare method name.
// Order is the order a player meets these, not the order the source lists them: you can walk
// into grass on turn one, and DexNav's hidden table needs a Hall of Fame first.
const METHOD_LABEL: Record<string, string> = {
  land: "Tall grass",
  water: "Surfing",
  rock_smash: "Rock Smash",
  fishing: "Fishing",
  hidden: "DexNav",
};
// The three rods are the same rule one level down: the source lists them alphabetically, so
// the Good Rod printed above the Old Rod a player has not been given yet.
const ROD_ORDER = ["old_rod", "good_rod", "super_rod"];
const rank = (order: string[], k: string) =>
  order.indexOf(k) < 0 ? order.length : order.indexOf(k);
const inOrder =
  (order: string[]) =>
  ([a]: [string, any], [b]: [string, any]) =>
    rank(order, a) - rank(order, b);
const byMethod = inOrder(Object.keys(METHOD_LABEL));
const byRod = inOrder(ROD_ORDER);
const METHOD_NOTE: Record<string, string> = {
  hidden:
    "Not a walking encounter. These are the hidden Pokémon the DexNav detector turns up here, and the detector unlocks at your first Hall of Fame.",
};

const items = m.object_events.filter(isItem);
const trainers = m.object_events.filter(isTrainer);

// Numbered callouts, the signature of a printed guide's aerial map. Built in Markers.ts so
// the chapter's inline maps draw the same overlay from the same order.
const markers = markersOf(m);

// Trainers whose battle happens on this map. Blue's fights are authored as one entry per
// player starter, so they are grouped and labelled rather than printed as three near-identical
// cards with no explanation of why they differ.
const placed = (trainerData as any).trainers.filter(
  (t: any) => t.placement?.map === m.id && t.difficulty !== "hard",
);
const STARTER =
  /_(BULBASAUR|CHARMANDER|SQUIRTLE|CHIKORITA|CYNDAQUIL|TOTODILE|TREECKO|TORCHIC|MUDKIP)$/;
const trainerGroups = new Map<string, any[]>();
for (const t of placed) {
  const key = (t.constant ?? "").replace(STARTER, "");
  (trainerGroups.get(key) ?? trainerGroups.set(key, []).get(key)!).push(t);
}
const cards = [...trainerGroups.values()].map((g) => {
  const starterPick = g.length > 1 && STARTER.test(g[0].constant ?? "");
  return {
    group: g,
    note: starterPick
      ? `Blue's team is built around the starter he picked to counter yours, so which of these ${g.length} teams you face depends on the starter you chose. Each is listed.`
      : null,
    starterPick,
  };
});
const trainerCount = cards.reduce((a, c) => a + c.group.length, 0);

const glance = [
  ["item", items.length, "ground item"],
  ["hidden", m.hidden_items.length, "hidden item"],
  ["trainer", trainers.length, "trainer"],
  ["warp", m.warps.length, "exit"],
].filter(([, c]) => (c as number) > 0);

const REGION_LABEL: Record<string, string> = {
  kanto: "Kanto",
  johto: "Johto",
  hoenn: "Hoenn",
  shared: "Shared",
};
const title = titleOf(m.id);

const gateOf = new Map<string, any>(
  (progression as any).gates.map((g: any) => [g.key, g]),
);
const spoilerLabel = gateLabel(gateOf.get(m.gate));

// Chapters declare the maps they cover, so a map page can link back to its walkthrough.
// Only chapters: an Insider Tips or Technical notes file also lists maps, and either would
// send "Walkthrough: ..." to a companion page instead of the chapter itself.
const chapter = chapterEntries().find(([, mod]: [string, any]) =>
  (mod.frontmatter?.maps ?? []).includes(m.id),
);
const chapterHref = chapter
  ? url("walkthrough/" + slugOfPath(chapter[0]) + "/")
  : null;
const chapterTitle = chapter?.[1]?.frontmatter?.title;
---

<Base
  title={title}
  eyebrow={REGION_LABEL[m.region] ?? m.region}
  subtitle={`${m.dimensions.width} × ${m.dimensions.height} blocks · ${prettyConst(m.map_type, "MAP_TYPE_")}`}
>
  <MapViewer
    image={url(img.image)}
    pixelWidth={img.pixel_width}
    pixelHeight={img.pixel_height}
    blockWidth={img.block_width}
    blockHeight={img.block_height}
    markers={markers}
  />

  {
    chapterHref && (
      <p class="chapterlink">
        <a href={chapterHref}>Walkthrough: {chapterTitle}</a>
      </p>
    )
  }

  {
    glance.length > 0 && (
      <p class="glance">
        {glance.map(([k, c, word]) => (
          // one expression, not three: JSX puts a text node between them and the chip
          // renders "5 exit s"
          <span class={`chip ${k}`}>{`${c} ${word}${c === 1 ? "" : "s"}`}</span>
        ))}
      </p>
    )
  }

  {
    m.hidden_items.length > 0 && (
      <Fold
        label="Hidden items"
        count={m.hidden_items.length}
        tone="hidden"
        open
      >
        <Spoiler
          gate={m.gate}
          label={spoilerLabel}
          severity={m.severity ?? "routine"}
        >
          <div class="scroll-x">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Item</th>
                  <th class="num">Qty</th>
                  <th class="num">Position</th>
                  <th>Underfoot</th>
                </tr>
              </thead>
              <tbody>
                {m.hidden_items.map((h: any, i: number) => (
                  <tr>
                    <td>
                      <span class="callout-n">{items.length + i + 1}</span>
                    </td>
                    <td>{prettyConst(h.item, "ITEM_")}</td>
                    <td class="num">{h.quantity}</td>
                    <td class="num">
                      {h.coord.x}, {h.coord.y}
                    </td>
                    <td>
                      {h.underfoot
                        ? "Yes — use the Itemfinder and step on it"
                        : "No"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Spoiler>
      </Fold>
    )
  }

  {
    enc.length > 0 && (
      <>
        <h2>Wild Pokémon</h2>
        {enc.map((e) => (
          <>
            {enc.length > 1 && <h3 class="tablabel">{e.labels.join(" / ")}</h3>}
            {Object.entries(e.methods ?? {})
              .sort(byMethod)
              .map(([name, meth]: [string, any]) =>
                meth.rods ? (
                  Object.entries(meth.rods)
                    .sort(byRod)
                    .map(([rod, tbl]: [string, any]) => (
                      <EncounterTable
                        title={`${METHOD_LABEL[name] ?? prettyConst(name, "")} — ${prettyConst(rod, "")}`}
                        stepRate={meth.encounter_rate}
                        total={tbl.percent_total}
                        slots={tbl.slots.map((s: any) => ({
                          percent: s.percent,
                          species: prettyConst(s.species, "SPECIES_"),
                          minLevel: s.min_level,
                          maxLevel: s.max_level,
                          enabled: s.species_enabled !== false,
                        }))}
                      />
                    ))
                ) : (
                  <EncounterTable
                    title={METHOD_LABEL[name] ?? prettyConst(name, "")}
                    note={METHOD_NOTE[name]}
                    stepRate={meth.encounter_rate}
                    total={meth.percent_total}
                    slots={meth.slots.map((s: any) => ({
                      percent: s.percent,
                      species: prettyConst(s.species, "SPECIES_"),
                      minLevel: s.min_level,
                      maxLevel: s.max_level,
                      enabled: s.species_enabled !== false,
                    }))}
                  />
                ),
              )}
          </>
        ))}
      </>
    )
  }

  {
    cards.length > 0 && (
      <>
        <h2>
          Trainers <span class="sect-count">({trainerCount})</span>
        </h2>
        {cards.map((c) => (
          <div class="tgroup">
            {c.note && <p class="tgnote">{c.note}</p>}
            {c.group.map((t: any) => (
              <Fold
                label={t.name ?? prettyConst(t.constant ?? "", "TRAINER_")}
                count={t.party.length}
                hint={
                  (t.class ?? "") +
                  (t.party.length
                    ? ` · to Lv ${Math.max(...t.party.map((p: any) => p.level ?? 0))}`
                    : "")
                }
                level={3}
                tone="trainer"
              >
                <TrainerCard
                  name={t.name ?? prettyConst(t.constant ?? "", "TRAINER_")}
                  cls={t.class ?? ""}
                  difficulty={t.difficulty}
                  note={
                    c.starterPick
                      ? `If you chose ${dex("SPECIES_" + (t.constant.match(STARTER)?.[1] ?? ""))}'s counter`
                      : t.anomaly === "frlg_boss_in_hoenn_slot"
                        ? "This slot is authored with a Kanto boss party rather than the trainer that belongs here. Shown as the data has it."
                        : null
                  }
                  party={t.party.map((p: any) => ({
                    name: dex(p.species),
                    level: p.level,
                    types: typesOf(p.species),
                    moves: (p.moves ?? []).map(move),
                    ability: ability(p.ability),
                    heldItem: itemName(p.held_item),
                    movesAreDefault: p.moves_are_default,
                  }))}
                />
              </Fold>
            ))}
          </div>
        ))}
      </>
    )
  }

  {
    m.connections.length > 0 && (
      <Fold
        label="Where this leads"
        count={m.connections.length}
        hint={m.connections.map((c: any) => c.direction).join(", ")}
        tone="warp"
      >
        <ul class="exits">
          {m.connections.map((c: any) => (
            <li>
              <span class="dir">{c.direction}</span>
              {manifest.has(c.map) ? (
                <a href={mapUrl(c.map)}>{titleOf(c.map)}</a>
              ) : (
                titleOf(c.map)
              )}
            </li>
          ))}
        </ul>
      </Fold>
    )
  }

  <p class="back"><a href={url("maps/")}>← All maps</a></p>
</Base>

<style>
  .glance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
  }
  .tablabel {
    color: var(--fg-faint);
  }
  .exits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.35rem 1.2rem;
  }
  .exits li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    padding: 0.35rem 0;
  }
  .dir {
    font: 700 0.68rem/1 var(--display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
    min-width: 4.2em;
  }
  .back {
    margin-top: 3rem;
  }
</style>

<style is:global>
  .tgroup {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  /* a grid does not collapse its children's margins, so the folds' own 1.9rem stacks on
     top of the 1rem gap and the trainer list falls apart */
  .tgroup > details.fold {
    margin: 0;
  }
  .tgnote {
    margin: 0;
    color: var(--fg-dim);
    font-size: 0.92rem;
    border-left: 3px solid var(--trainer);
    padding-left: 0.8rem;
  }
</style>

<style>
  .chapterlink {
    margin: 1rem 0 0;
  }
  .chapterlink a {
    display: inline-block;
    font: 700 0.74rem/1 var(--display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.55em 0.9em 0.48em;
    text-decoration: none;
  }
  .chapterlink a:hover {
    background: var(--accent);
    color: var(--ink);
  }
</style>
