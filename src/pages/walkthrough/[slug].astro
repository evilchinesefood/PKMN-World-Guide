---
// A walkthrough chapter: the printed-guide unit. The walk runs down the main column as a
// sequence of places, each one its own aerial map with the steps numbered onto it, and the
// Insider Tips boxed in the rail beside it. This is the page M2 locks -- brief section 7
// requires one segment finished completely before scaling to three regions.
import Base from "../../layouts/Base.astro";
import Spoiler from "../../components/Spoiler.astro";
import MapViewer from "../../components/MapViewer.astro";
import Fold from "../../components/Fold.astro";
import { url, mapUrl } from "../../Url";
import { gateLabel, titleOf } from "../../Names";
import { markersOf } from "../../Markers";
import mapsData from "../../../data/generated/maps.json";
import manifestData from "../../../data/manifest/map-manifest.json";
import progression from "../../../data/generated/progression.json";
import {
  chapterBySlug,
  chapterEntries,
  companionOf,
  slugOfPath,
  technicalOf,
} from "../../Chapters";
import { sectionsOf, stepsOf } from "../../Steps";
import { chapterBody, checkSource, isTaskList } from "../../Checklist";
import { scrollTables } from "../../Html";
import { readFileSync } from "node:fs";
import { join } from "node:path";

export async function getStaticPaths() {
  return chapterEntries().map(([p]) => ({ params: { slug: slugOfPath(p) } }));
}

const { slug } = Astro.params;
const [path, mod] = chapterBySlug(slug!)!;
const fm = mod.frontmatter ?? {};

// The companion files point back at their chapter, so both pairings are declared in the
// content rather than guessed from filenames.
const Tips = companionOf(path)?.Content;
const technical = technicalOf(path);
const technicalHref = technical ? url(`technical/${slug}/`) : null;

const maps = new Map<string, any>(
  (mapsData as any).maps.map((m: any) => [m.id, m]),
);
const manifest = new Map<string, any>(
  (manifestData as any).maps.map((m: any) => [m.map_id, m]),
);
const covered = (fm.maps ?? []).filter((id: string) => manifest.has(id));

// The numbered walk. It runs ABOVE the markdown body because the body is what surrounds a
// walk in a printed chapter, not what precedes it: reference tables the reader consults while
// walking, then "what you cannot reach yet", "where you go next" and a departure checklist
// that only means anything after the walk is done.
// Each section carries its own aerial map, drawn beside the steps that walk it -- the whole
// point of the genre. A section whose map is missing from the manifest still renders its
// steps; it just gets no map.
const sections = sectionsOf(fm).map((s: any) => ({
  ...s,
  list: stepsOf(s),
  img: manifest.get(s.map) ?? null,
  markers: maps.has(s.map) ? markersOf(maps.get(s.map)) : [],
}));

const gateOf = new Map<string, any>(
  (progression as any).gates.map((g: any) => [g.key, g]),
);
// A gate is a FLOOR, never a sufficient condition (DATA-AUDIT Q19), so the label says
// "from X onwards" rather than "requires X" (decision 16). This page used to carry its own
// copy of that formatting and the copy had drifted -- it printed "Kanto — from Kanto badge 1
// onwards" where the map pages printed "from badge 1 onwards". One implementation, in Names.ts.
const gateText = gateLabel(gateOf.get(fm.gate));

// Decision 27 -- everything that is not a numbered walkthrough step starts collapsed -- was
// written for the reference pages and never reached the chapter body, which is the one page
// the readability phase existed to fix. The body is markdown, so the split is done on the
// compiled HTML: each <h2> opens a section, and a section carrying reference rows (table rows
// or list items) becomes a closed fold whose count IS those rows, so the summary and the
// contents can never disagree. A prose-only section stays open: it has no count to summarise,
// and "where you go next" must never sit behind a click.
// Numbered steps are rendered above, from frontmatter, and are never folded.
//
// A TASK LIST stays open too, and that is the rule, not an exception for one chapter. A
// checklist is not reference material a reader consults when they want it -- it is the
// chapter's exit gate, functionally the last step, and its whole value is being in the
// reader's face at the moment they are about to leave. A checklist nobody opens is a
// checklist that does not work. The signal is mechanical, so every chapter M5 writes inherits
// it: markdown's `- [ ]` compiles to a checkbox input, and nothing else on these pages does.
//
// Note this renders the body's HTML rather than <Content />, so a chapter that wants Astro to
// process a relative image would need the component back.
const rowsIn = (h: string) =>
  isTaskList(h)
    ? 0
    : (h.match(/<tbody>[\s\S]*?<\/tbody>/g) ?? []).join("").split("<tr")
        .length -
      1 +
      (h.match(/<li\b/g) ?? []).length;

// The split and the checklist scope both live in src/Checklist.ts, because a chapter is several
// sections and whoever owns the loop owns the scope -- owning it here is what made it per-section
// instead of per-chapter. The fold count is still this page's business (decision 38) and is read
// off `raw`, the compiled markdown before any rewrite, so neither making boxes tickable nor
// boxing a table in its own scroller can change which sections fold.
const checks = chapterBody(await mod.compiledContent());
const body = checks.sections.map((s) => ({
  ...s,
  count: rowsIn(s.raw),
  html: scrollTables(s.html),
}));

// THE HANDOFF NEVER FOLDS, AND IT IS DECIDED BY POSITION RATHER THAN BY WORDING.
// "Where you go next" is the one body section a reader must not have to click for, and the
// rule above would fold it the moment it carried two bullet points -- silently, since a fold
// looks exactly like an unfolded section until you notice the chevron. On this chapter it was
// safe only by accident: its handoff happens to be prose-only.
//
// Matching the heading was the obvious fix and it is the wrong one. This chapter's handoff is
// called "What is ahead on Route 2" -- the phrase "where you go next" appears nowhere in the
// content, only in this file's own comments -- so a vocabulary of headings would already have
// failed on the only chapter that exists, and would keep failing quietly on 45-58 more, each
// author naming the section after the place they are sending the reader to.
//
// Position is the signal the chapter shape already carries (see the comment above the walk):
// reference first, then what you cannot reach yet, then where you go next, then the departure
// checklist. So the LAST body section before the checklist -- or the last section outright when
// a chapter has no checklist -- is the handoff and is exempt. It costs the author nothing to
// remember, which is the point; the contract on the Technical page says where the handoff goes,
// and the renderer keeps it open whatever it is made of.
//
// The failure it can still have is the benign one: a reference section written after the
// handoff renders open instead of folded, which is more scrolling, not a hidden instruction.
const lastTask = body.reduce((k, s, i) => (s.task ? i : k), -1);
const handoff = lastTask === -1 ? body.length - 1 : lastTask - 1;

// Build-time checks on the chapter, warned rather than thrown -- the same instrument, and the
// same reasoning, as decision 47: a content mistake must not be able to break the deploy, but
// it must not be silent either. Read from the file rather than rawContent() so the line number
// counts the frontmatter and lands where the author will look. BUILD-TIME ONLY, same contract
// as src/Features.ts: Astro evaluates this in Node and never bundles it for the browser.
const source = readFileSync(
  join(process.cwd(), path.replace(/^\/+/, "")),
  "utf8",
);
for (const w of checkSource(source, path.replace(/^\/+/, "")))
  console.warn(`[checklist] ${w}`);
if (checks.repeated.length)
  console.warn(
    `[checklist] ${path.replace(/^\/+/, "")}: ${checks.repeated.length} checklist sentence(s) appear more than once: ${checks.repeated
      .map((s) => `"${s}"`)
      .join(
        ", ",
      )}. Each later copy is keyed separately so a tick cannot spread, but deleting one shifts the survivors onto the earlier keys (decision 48). Reword them and the ambiguity goes away.`,
  );
// An item the rewrite declined is a box that renders and does nothing -- the signature of every
// silent failure this feature has had. It is left whole rather than half-rewritten, and said out
// loud rather than left to be found on the page, which is where the other five were not found.
if (checks.skipped.length)
  console.warn(
    `[checklist] ${path.replace(/^\/+/, "")}: ${checks.skipped.length} checklist item(s) in a shape src/Checklist.ts does not recognise: ${checks.skipped
      .map((s) => `"${s}"`)
      .join(
        ", ",
      )}. Each is left exactly as written, which means its box renders and cannot be ticked. Write it as an ordinary "- [ ] sentence", or teach src/Checklist.ts the shape.`,
  );
---

<Base
  title={fm.title ?? slug}
  eyebrow={`${(fm.region ?? "").toString().toUpperCase()} Walkthrough`}
  subtitle={`${covered.length} maps · ${gateText}`}
>
  <div class="split">
    <div class="prose">
      {
        sections.map((s: any) => (
          <section class="walk" id={s.id} data-map={s.map}>
            <h2>{s.title}</h2>
            {s.note && <p class="note">{s.note}</p>}
            {s.img && (
              <figure class="walk-map">
                <MapViewer
                  id={`map-${s.id}`}
                  steps={s.id}
                  compact
                  image={url(s.img.image)}
                  pixelWidth={s.img.pixel_width}
                  pixelHeight={s.img.pixel_height}
                  blockWidth={s.img.block_width}
                  blockHeight={s.img.block_height}
                  markers={s.markers}
                />
                <figcaption>
                  <a href={mapUrl(s.map)}>{titleOf(s.map)} — full map page</a>
                </figcaption>
              </figure>
            )}
            <ol class="steps">
              {s.list.map((st: any) => (
                <li
                  class:list={["step", st.group && "choice"]}
                  data-step={st.n}
                  data-at={st.at ? `${st.at[0]},${st.at[1]}` : undefined}
                  data-choice-group={st.group ?? undefined}
                >
                  {st.label && <p class="choice-lead">{st.label}</p>}
                  {st.text}
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      {
        body.map((p: any, i: number) =>
          p.label == null ? (
            <Fragment set:html={p.html} />
          ) : p.count > 0 && i !== handoff ? (
            <Fold label={p.label} count={p.count} id={p.id}>
              <Fragment set:html={p.html} />
            </Fold>
          ) : p.task ? (
            <div class="checklist" data-chapter={slug}>
              <Fragment set:html={p.head + p.html} />
              <p class="check-tools">
                <button class="check-clear" type="button">
                  Clear checklist
                </button>
              </p>
            </div>
          ) : (
            <Fragment set:html={p.head + p.html} />
          ),
        )
      }

      {
        technicalHref && (
          <p class="technote">
            Every number on this page was traced to the game's own source.{" "}
            <a href={technicalHref}>Technical notes for this chapter</a> has the
            flags, files and tables behind it.
          </p>
        )
      }
    </div>

    <aside class="rail">
      {
        Tips && (
          <div class="tips">
            <span class="label">Insider Tips</span>
            <Spoiler
              gate={fm.gate}
              label={gateText}
              severity={fm.severity ?? "story"}
            >
              <Tips />
            </Spoiler>
          </div>
        )
      }

      <div class="panel maplist">
        <span class="label">Maps in this chapter</span>
        <ul>
          {
            covered.map((id: string) => (
              <li>
                <a href={mapUrl(id)}>{titleOf(id)}</a>
                <span class="dims">
                  {maps.get(id)?.dimensions.width}×
                  {maps.get(id)?.dimensions.height}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>

  <p class="back"><a href={url("/")}>← All chapters</a></p>
</Base>

<style>
  /* The chapter's own H1 duplicates the masthead, which already renders fm.title. */
  .prose :global(h1) {
    display: none;
  }
  .prose :global(h2) {
    margin-top: 2.4rem;
  }
  .prose :global(h3) {
    color: var(--fg);
    font-size: 1rem;
    margin-top: 1.8rem;
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 68ch;
  }
  .prose :global(em) {
    color: var(--fg-faint);
    font-style: normal;
    font-size: 0.88em;
    display: inline-block;
    margin-top: 0.2rem;
  }
  .prose :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--rule-hot);
    color: var(--fg-dim);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 2px solid var(--rule);
    margin: 2.5rem 0;
  }
  /* Sections carry an id so a step can be linked to, and a top rule so the walk reads as a
     sequence of places rather than one long list. */
  .walk + .walk {
    margin-top: 2.6rem;
  }
  /* a section is an anchor target, and the banner is sticky over the top of it */
  .walk {
    scroll-margin-top: calc(var(--banner-h, 3.1rem) + 0.5rem);
  }
  .walk .note {
    color: var(--fg-dim);
    max-width: 68ch;
  }
  /* The aerial map sits between the section's heading and its steps, the way a printed
     guide sets it: see the place, then walk it. Full column width, because a map you have
     to squint at is not a map. */
  .walk-map {
    margin: 1.2rem 0 1.6rem;
  }
  /* ...AND THEN IT STAYS THERE WHILE THE STEPS SCROLL PAST IT.
     A printed guide sets the map and its steps on one spread; a web page sets them one after
     the other, and past about six steps the two stop being on screen together. Viridian City
     is fourteen steps and eight of them are a tile-by-tile walking route -- sentences that
     exist only to be read against the map -- with the last of them 1,068px below a 550px map
     at 1280 and 1,631px below it at 390. Measured across all 44 steps with each step scrolled
     to the middle of the viewport, 15 of 44 had ZERO map pixels on screen at 1280 and 23 of 44
     at 390. Pin N is step N (decision 26), and that pairing is worth nothing when the two are
     never visible at once.
     Sticking the figure inside its own <section> is what keeps the release automatic: the map
     follows exactly its own steps and lets go at the section boundary, because a section IS
     one map. Nothing else in the page changes -- same markup, same one viewer per section,
     same lazy mount.
     Three things it must not do, all handled below: cover the banner, follow the reader as an
     empty box when the map never mounted, or fill the screen it is stuck to. */
  /* The whole selector is `:global` because Astro strips `:global()` only in descendant
     position -- inside `:has()` it is left in the output verbatim and the rule silently never
     matches anything. `.walk-map` exists on this page and nowhere else, so scoping it buys
     nothing here anyway. */
  :global(.walk-map:has(.leaflet-container)) {
    position: sticky;
    /* published by Base.astro, because the banner wraps and its height is not a constant */
    top: var(--banner-h, 3.1rem);
    /* ol.steps > li is position:relative, so without this the steps -- which come later in the
       document -- paint over the map they are scrolling under. The banner's 500 still wins. */
    z-index: 2;
    /* Opaque, and the bottom margin becomes padding, because a margin is not painted: the
       legend and the caption are mostly gaps and a step would be seen sliding behind them. */
    background: var(--ink);
    padding: 0.5rem 0 1rem;
    margin: 0.7rem 0 0.6rem;
  }
  /* `:has()` ties sticking to a map that actually MOUNTED. With JavaScript off the viewer is a
     reserved empty box, and an empty box that follows the reader down the page is worse than
     one that scrolls away; a browser without `:has()` (Firefox before 121) simply gets the
     old layout, which is the behaviour this replaces. */

  /* A stuck map must leave room for the steps it is stuck for. 30rem is the design height and
     it stands on a tall window; on an 800px-high laptop the cap makes it 52vh, which keeps
     about three steps under it. `.compact` is set by this page and by nothing else, so the
     1,195 map pages are untouched. */
  .walk-map :global(.pw-viewer.compact) {
    max-height: min(30rem, 52vh);
    min-height: min(18rem, 40vh);
  }

  /* Room to breathe when a pin scrolls its step to the bottom of the viewport, and room for
     the stuck map when an anchor scrolls a step to the top. */
  .prose :global(ol.steps > li) {
    scroll-margin-block: var(--banner-h, 3.1rem) 1.5rem;
  }

  /* Paper does not scroll, so there is nothing to stay with; `position: sticky` in paged media
     is a needless risk over a layout that is already correct, and `vh` there is the page box
     rather than a window. Decision 35's nine mounted viewers print exactly as before. */
  @media print {
    /* The whole selector is `:global` because Astro strips `:global()` only in descendant
     position -- inside `:has()` it is left in the output verbatim and the rule silently never
     matches anything. `.walk-map` exists on this page and nowhere else, so scoping it buys
     nothing here anyway. */
    :global(.walk-map:has(.leaflet-container)) {
      position: static;
      z-index: auto;
      background: none;
      padding: 0;
      margin: 1.2rem 0 1.6rem;
    }
    .walk-map :global(.pw-viewer.compact) {
      max-height: 30rem;
      min-height: 18rem;
    }
  }
  .walk-map figcaption {
    margin-top: 0.5rem;
  }
  .walk-map figcaption a {
    font: 700 0.68rem/1 var(--display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .walk-map figcaption a:hover {
    color: var(--accent);
  }
  .technote {
    margin-top: 3rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--fg-faint);
    max-width: 68ch;
  }
  .rail {
    position: sticky;
    top: 4.5rem;
    display: grid;
    gap: 1rem;
  }
  .rail :global(h1) {
    display: none;
  }
  .rail :global(h2) {
    font-size: 0.95rem;
    margin: 1.2rem 0 0.4rem;
    color: var(--accent);
  }
  .rail :global(h2::after) {
    display: none;
  }
  .rail :global(p) {
    font-size: 0.9rem;
  }
  .maplist ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }
  .maplist li {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.28rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .maplist li:last-child {
    border-bottom: 0;
  }
  .dims {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
  }
  .back {
    margin-top: 3rem;
  }
</style>

<script>
  // The departure checklist's ticks. One key per chapter, so the three regions M5 adds cannot
  // collide; item identity is a hash of the item's own text, minted at build time by
  // Checklist.ts, so an inserted item starts unticked instead of inheriting the slot's tick.
  document.querySelectorAll<HTMLElement>(".checklist").forEach((list) => {
    const key = `pw-checked:${list.dataset.chapter}`;
    const read = (): string[] => {
      try {
        return JSON.parse(localStorage.getItem(key) || "[]");
      } catch {
        return [];
      }
    };
    const done = new Set(read());
    const boxes = list.querySelectorAll<HTMLInputElement>("input[data-check]");

    boxes.forEach((box) => {
      const id = box.dataset.check!;
      box.checked = done.has(id);
      box.addEventListener("change", () => {
        if (box.checked) done.add(id);
        else done.delete(id);
        localStorage.setItem(key, JSON.stringify([...done]));
      });
    });

    list.querySelector(".check-clear")?.addEventListener("click", () => {
      boxes.forEach((b) => (b.checked = false));
      done.clear();
      localStorage.removeItem(key);
    });
  });
</script>
