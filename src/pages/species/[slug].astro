---
// One page per national dex number, with alternate forms folded in as sections rather than
// given pages of their own -- Charizard, Mega Charizard X and Mega Charizard Y are one entry
// in a printed guide. 430 pages from 596 enabled species (104 dex numbers carry forms).
//
// Disabled species get no page at all: 975 of the 1571 table entries are compiled out of the
// ROM, and a page for one would document a Pokémon that cannot exist in this game.
import Base from "../../layouts/Base.astro";
import Fold from "../../components/Fold.astro";
import { url, mapUrl } from "../../Url";
import { titleOf, prettyConst } from "../../Names";
import { frontSprite } from "../../Sprites";
import speciesData from "../../../data/generated/species.json";
import battle from "../../../data/generated/battledata.json";

const B = battle as any;
const all: any[] = (speciesData as any).species.filter((s: any) => s.enabled);

function dexSlug(n: number) {
  return String(n).padStart(3, "0");
}

export async function getStaticPaths() {
  const sp: any[] = (
    await import("../../../data/generated/species.json")
  ).default.species.filter((s: any) => s.enabled);
  const dex = [...new Set(sp.map((s) => s.national_dex))];
  return dex.map((n) => ({ params: { slug: String(n).padStart(3, "0") } }));
}

const { slug } = Astro.params;
const dexNo = Number(slug);
const forms = all.filter((s) => s.national_dex === dexNo);
// The base form is the one whose id has no form suffix; fall back to the shortest id.
// PRIMAL/ATTACK/DEFENSE/SPEED/RAINY/SNOWY/SUNNY were missing, which is why dex 386 resolved
// to SPECIES_DEOXYS_ATTACK -- a form whose only obtainable_via entry is a form link -- and
// published a page with no acquisition information at all while SPECIES_DEOXYS_NORMAL, the
// Birth Island static, sat on a sibling. 386 is the only dex number this changes.
const base =
  forms.find(
    (s) =>
      !/_(MEGA|ALOLA|GALAR|HISUI|PALDEA|GMAX|Z|PRIMAL|ATTACK|DEFENSE|SPEED|RAINY|SNOWY|SUNNY)(_|$)/.test(
        s.id,
      ),
  ) ?? forms[0];
const alts = forms.filter((s) => s !== base);

// BattleData.py asserts full coverage of every move, species, ability, type and item these
// pages reference, so a miss is an extractor failure rather than something to paper over on
// the page. Verified: 0 missing across all 596 enabled species.
const moveName = (k: string) => B.moves[k].name;
const typeName = (k: string) => B.types[k].name;
const abilityName = (k: string) => B.abilities[k].name;
const dexName = (k: string) => B.species[k].name;
const itemNm = (k: string) => B.items[k].name;

// abilities is {primary, secondary, hidden}, not a list, and secondary is usually null.
const abilitiesOf = (s: any) => {
  const a = s.abilities ?? {};
  const out: { name: string; hidden: boolean }[] = [];
  for (const k of ["primary", "secondary"])
    if (a[k]) out.push({ name: abilityName(a[k]), hidden: false });
  if (a.hidden) out.push({ name: abilityName(a.hidden), hidden: true });
  return out;
};

const typesOf = (s: any) => {
  const t = B.species?.[s.id]?.types;
  return t
    ? [...new Set([t.primary, t.secondary].filter(Boolean))].map((x: any) =>
        typeName(x),
      )
    : [];
};
const statsOf = (s: any) => B.species?.[s.id]?.base_stats ?? s.base_stats ?? {};
const STAT_ORDER: [string, string][] = [
  ["hp", "HP"],
  ["attack", "Atk"],
  ["defense", "Def"],
  ["sp_attack", "SpA"],
  ["sp_defense", "SpD"],
  ["speed", "Spe"],
];

// A gate is a floor; here it is only used to sort, so the earliest place you can get one
// leads. `percent` is the merged rate for that species on that map and method.
const wild = (base.obtainable_via ?? []).filter((o: any) => o.kind === "wild");
const evoFrom = (base.obtainable_via ?? []).filter(
  (o: any) => o.kind === "evolution",
);
// `form` entries are the Mega/alternate-form links, not a way to obtain anything -- on
// Charizard they render as six identical "from Charizard" rows, because the GBA name field
// of every Mega is the base name. The forms themselves are already listed, with their stats,
// in the Base stats table above, so nothing is lost by keeping them out of this list.
// 74 species carry nothing but `form` entries; 20 of those are NOT Megas (11 GMAX, 3 Castform,
// 2 Primal, 3 Deoxys). Whether that matters depends entirely on whether such a species is ever
// chosen as a page's `base`, and with the form-suffix list above complete, none is.
const other = (base.obtainable_via ?? []).filter(
  (o: any) => !["wild", "evolution", "form"].includes(o.kind),
);
const sourceCount = wild.length + evoFrom.length + other.length;
// Two different nothings. `noSource` is a species the game genuinely never produces.
// `formOnly` is one that exists solely as a form of another entry -- true of no page today,
// because base selection above never lands on such a species, but the filter above can empty
// this section without emptying `obtainable_via`, and an open fold with nothing in it is the
// worst failure this page can have. The guard is the floor; the sentence stays true either way.
const noSource = !base.obtainable_via;
const formOnly = !noSource && sourceCount === 0;
const unreachable = noSource || formOnly;

// Every kind that reaches this list needs a label, or the row renders as a bare chip with
// nothing after it -- `breed` and `roamer` had none.
const KIND: Record<string, string> = {
  starter: "Starter",
  gift: "Gift",
  egg: "Egg",
  static: "Static battle",
  trade: "Trade",
  breed: "Breeding",
  roamer: "Roaming",
};
const METHOD: Record<string, string> = {
  land: "Tall grass",
  water: "Surfing",
  rock_smash: "Rock Smash",
  fishing: "Fishing",
  hidden: "DexNav",
};

function evoText(e: any) {
  const m = e.method;
  if (m === "EVO_LEVEL" && e.level) return `Level ${e.level}`;
  if (m === "EVO_ITEM") return `Use ${itemNm(e.param)}`;
  // Trade evolutions have an item twin; one row states both (DECISIONS.md, audit Q16).
  if (m === "EVO_TRADE") return "Trade";
  if (m === "EVO_LEVEL" && !e.level) return "Level up";
  return prettyConst(m, "EVO_");
}

const title = base.name ?? prettyConst(base.id, "SPECIES_");

// A collapsed fold still has to answer the question the reader came with, so each summary
// carries the one number that decides whether it is worth opening: the stat total, how many
// places you can get one, how high the learnset goes.
const baseTotal = STAT_ORDER.reduce((a, [k]) => a + (statsOf(base)[k] ?? 0), 0);
const learnset: any[] = base.level_up_learnset ?? [];
// Read both bounds off the table, the way EncounterTable does. 116 of the 430 species open
// their learnset at level 0 -- the moves an evolution hands over -- so a hardcoded lower
// bound contradicted the first row of the table one line below it.
const levels: number[] = learnset.map((l: any) => l.level);
const loLevel = levels.length ? Math.min(...levels) : 0;
const topLevel = levels.length ? Math.max(...levels) : 0;
const abilities = abilitiesOf(base);
// The front pic is the base form's, matching the form this page is named for. Null when the
// sprites have not been extracted, in which case the page reads exactly as it did before.
const portrait = frontSprite(slug!);
---

<Base
  title={title}
  eyebrow={`No. ${slug}`}
  subtitle={typesOf(base).join(" · ") +
    (alts.length
      ? ` · ${alts.length} alternate form${alts.length === 1 ? "" : "s"}`
      : "")}
>
  {
    portrait && (
      <p class="portrait">
        <img
          class="sprite"
          src={portrait}
          width="128"
          height="128"
          alt={`${title} sprite`}
        />
      </p>
    )
  }

  <Fold
    label="Base stats"
    hint={`Total ${baseTotal}${alts.length ? ` · ${forms.length} forms` : ""}`}
  >
    <div class="scroll-x">
      <table>
        <thead>
          <tr>
            <th>Form</th>
            <th>Types</th>
            {STAT_ORDER.map(([, l]) => <th class="num">{l}</th>)}
            <th class="num">Total</th>
          </tr>
        </thead>
        <tbody>
          {
            forms.map((s) => {
              const st = statsOf(s);
              const tot = STAT_ORDER.reduce((a, [k]) => a + (st[k] ?? 0), 0);
              return (
                <tr>
                  <td>
                    {s === base
                      ? title
                      : (s.name ?? prettyConst(s.id, "SPECIES_"))}
                  </td>
                  <td>
                    {typesOf(s).map((t) => (
                      <span class="chip">{t}</span>
                    ))}
                  </td>
                  {STAT_ORDER.map(([k]) => (
                    <td class="num">{st[k] ?? "—"}</td>
                  ))}
                  <td class="num">{tot || "—"}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </Fold>

  {
    abilities.length > 0 && (
      <Fold
        label="Abilities"
        count={abilities.length}
        hint={abilities.some((a) => a.hidden) ? "1 hidden" : null}
      >
        <ul class="other">
          {abilities.map((a) => (
            <li>
              {a.name}
              {a.hidden && <span class="chip">Hidden</span>}
            </li>
          ))}
        </ul>
      </Fold>
    )
  }

  <Fold
    label="Where to get it"
    count={unreachable ? null : sourceCount}
    hint={unreachable ? "Nothing in the game produces it" : null}
    open
  >
    {
      formOnly ? (
        <p class="unreach">
          <strong>This one only exists as a form of another Pokémon.</strong>{" "}
          You cannot catch, hatch, trade or evolve into it — it appears when the
          Pokémon it belongs to changes form. Its stats are in the table above.
        </p>
      ) : unreachable ? (
        <p class="unreach">
          <strong>Nothing in the game produces this Pokémon.</strong> It is
          compiled into the ROM and will work if you obtain one another way, but
          no wild encounter, gift, trade, static battle or reachable evolution
          yields it. Filter the <a href={url("species/")}>Pokédex</a> for{" "}
          <code>unreachable</code> to see the rest.
        </p>
      ) : (
        <>
          {wild.length > 0 && (
            <div class="scroll-x">
              <table>
                <thead>
                  <tr>
                    <th class="num">Rate</th>
                    <th>Where</th>
                    <th>How</th>
                    <th class="num">Levels</th>
                  </tr>
                </thead>
                <tbody>
                  {wild.map((o: any) => (
                    <tr>
                      <td class="num">{o.percent}%</td>
                      <td>
                        <a href={mapUrl(o.map)}>{titleOf(o.map)}</a>
                        <span class="reg">{o.region}</span>
                      </td>
                      <td>
                        {METHOD[o.method] ?? prettyConst(o.method, "")}
                        {o.rod && ` (${prettyConst(o.rod, "")})`}
                      </td>
                      <td class="num">
                        {o.min_level === o.max_level
                          ? o.min_level
                          : `${o.min_level}–${o.max_level}`}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {evoFrom.length > 0 && (
            <p class="evo">
              Evolves from{" "}
              {evoFrom.map((e: any, i: number) => (
                <>
                  {i > 0 && ", "}
                  <a
                    href={url(
                      `species/${dexSlug(all.find((x) => x.id === e.from)?.national_dex ?? 0)}/`,
                    )}
                  >
                    {dexName(e.from)}
                  </a>{" "}
                  ({evoText(e)})
                </>
              ))}
              .
            </p>
          )}

          {other.length > 0 && (
            <ul class="other">
              {other.map((o: any) => (
                <li>
                  <span class="chip">{KIND[o.kind] ?? o.kind}</span>
                  {o.map ? <a href={mapUrl(o.map)}>{titleOf(o.map)}</a> : null}
                  {o.region && <span class="reg">{o.region}</span>}
                  {o.kind === "trade" && o.wants && (
                    <> — wants {dexName(o.wants)}</>
                  )}
                  {o.kind === "starter" && (
                    <> — one of the three starting choices</>
                  )}
                  {o.kind === "breed" && o.from && (
                    <> — breed a {dexName(o.from)}</>
                  )}
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }
  </Fold>

  {
    (base.evolutions ?? []).filter((e: any) => e.method !== "EVO_NONE").length >
      0 && (
      <>
        <h2>Evolves into</h2>
        <ul class="other">
          {base.evolutions
            .filter((e: any) => e.method !== "EVO_NONE")
            .map((e: any) => (
              <li>
                <a
                  href={url(
                    `species/${dexSlug(all.find((x) => x.id === e.target_species)?.national_dex ?? 0)}/`,
                  )}
                >
                  {dexName(e.target_species)}
                </a>{" "}
                — {evoText(e)}
                {(e.conditions ?? []).length > 0 && (
                  <span class="cond">
                    {" "}
                    (
                    {e.conditions
                      .map((c: any) => prettyConst(c.type ?? String(c), "IF_"))
                      .join(", ")}
                    )
                  </span>
                )}
              </li>
            ))}
        </ul>
      </>
    )
  }

  {
    learnset.length > 0 && (
      <Fold
        label="Level-up moves"
        count={learnset.length}
        hint={
          loLevel === topLevel ? `Lv ${loLevel}` : `Lv ${loLevel}–${topLevel}`
        }
      >
        <div class="scroll-x">
          <table>
            <thead>
              <tr>
                <th class="num">Lv</th>
                <th>Move</th>
                <th>Type</th>
                <th class="num">Pwr</th>
                <th class="num">Acc</th>
              </tr>
            </thead>
            <tbody>
              {base.level_up_learnset.map((l: any) => {
                const mv = B.moves?.[l.move] ?? {};
                return (
                  <tr>
                    <td class="num">{l.level}</td>
                    <td>{moveName(l.move)}</td>
                    <td>{mv.type ? typeName(mv.type) : "—"}</td>
                    <td class="num">{mv.power || "—"}</td>
                    <td class="num">{mv.accuracy || "—"}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </Fold>
    )
  }

  <p class="back"><a href={url("species/")}>← All Pokémon</a></p>
</Base>

<style>
  .reg {
    font-size: 0.75rem;
    color: var(--fg-faint);
    text-transform: capitalize;
    margin-left: 0.5em;
  }
  .unreach {
    border-left: 3px solid var(--trainer);
    padding-left: 0.9rem;
    color: var(--fg-dim);
    max-width: 68ch;
  }
  .evo,
  .other {
    max-width: 68ch;
  }
  .other {
    list-style: none;
    padding: 0;
  }
  .other li {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--rule);
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
  }
  .cond {
    color: var(--fg-faint);
    font-size: 0.85em;
  }
  .back {
    margin-top: 3rem;
  }
</style>
