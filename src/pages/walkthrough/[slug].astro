---
// A walkthrough chapter: the printed-guide unit. Prose runs down the main column with the
// Insider Tips boxed in the rail beside it, and every map the chapter covers is linked with
// its aerial view. This is the page M2 locks -- brief section 7 requires one segment finished
// completely before scaling to three regions.
import Base from "../../layouts/Base.astro";
import Spoiler from "../../components/Spoiler.astro";
import { url, mapUrl } from "../../Url";
import { titleOf } from "../../Names";
import mapsData from "../../../data/generated/maps.json";
import manifestData from "../../../data/manifest/map-manifest.json";
import progression from "../../../data/generated/progression.json";
import {
  chapterBySlug,
  chapterEntries,
  companionOf,
  slugOfPath,
  technicalOf,
} from "../../Chapters";
import { sectionsOf, stepsOf } from "../../Steps";

export async function getStaticPaths() {
  return chapterEntries().map(([p]) => ({ params: { slug: slugOfPath(p) } }));
}

const { slug } = Astro.params;
const [path, mod] = chapterBySlug(slug!)!;
const fm = mod.frontmatter ?? {};
const Body = mod.Content;

// The companion files point back at their chapter, so both pairings are declared in the
// content rather than guessed from filenames.
const Tips = companionOf(path)?.Content;
const technical = technicalOf(path);
const technicalHref = technical ? url(`technical/${slug}/`) : null;

const maps = new Map<string, any>(
  (mapsData as any).maps.map((m: any) => [m.id, m]),
);
const manifest = new Map<string, any>(
  (manifestData as any).maps.map((m: any) => [m.map_id, m]),
);
const covered = (fm.maps ?? []).filter((id: string) => manifest.has(id));

// The numbered walk. It runs ABOVE the markdown body because the body is what surrounds a
// walk in a printed chapter, not what precedes it: reference tables the reader consults while
// walking, then "what you cannot reach yet", "where you go next" and a departure checklist
// that only means anything after the walk is done.
const sections = sectionsOf(fm).map((s: any) => ({ ...s, list: stepsOf(s) }));

const gateOf = new Map<string, any>(
  (progression as any).gates.map((g: any) => [g.key, g]),
);
const gate = gateOf.get(fm.gate);
// A gate is a FLOOR, never a sufficient condition (DATA-AUDIT Q19), so the label says
// "from X onwards" rather than "requires X" -- the latter would imply X is all you need.
const gateLabel = gate
  ? gate.always_available
    ? `${(gate.region ?? "").toString().replace(/^./, (c: string) => c.toUpperCase())} — from the start`
    : `${(gate.region ?? "Global").toString().replace(/^./, (c: string) => c.toUpperCase())} — from ${gate.label} onwards`
  : "Later in the game";
---

<Base
  title={fm.title ?? slug}
  eyebrow={`${(fm.region ?? "").toString().toUpperCase()} Walkthrough`}
  subtitle={`${covered.length} maps · ${gateLabel}`}
>
  <div class="split">
    <div class="prose">
      {
        sections.map((s: any) => (
          <section class="walk" id={s.id} data-map={s.map}>
            <h2>{s.title}</h2>
            {s.note && <p class="note">{s.note}</p>}
            <ol class="steps">
              {s.list.map((st: any) => (
                <li
                  class:list={["step", st.group && "choice"]}
                  data-step={st.n}
                  data-at={st.at ? `${st.at[0]},${st.at[1]}` : undefined}
                  data-choice-group={st.group ?? undefined}
                >
                  {st.label && <p class="choice-lead">{st.label}</p>}
                  {st.text}
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <Body />

      {
        technicalHref && (
          <p class="technote">
            Every number on this page was traced to the game's own source.{" "}
            <a href={technicalHref}>Technical notes for this chapter</a> has the
            flags, files and tables behind it.
          </p>
        )
      }
    </div>

    <aside class="rail">
      {
        Tips && (
          <div class="tips">
            <span class="label">Insider Tips</span>
            <Spoiler
              gate={fm.gate}
              label={gateLabel}
              severity={fm.severity ?? "story"}
            >
              <Tips />
            </Spoiler>
          </div>
        )
      }

      <div class="panel maplist">
        <span class="label">Maps in this chapter</span>
        <ul>
          {
            covered.map((id: string) => (
              <li>
                <a href={mapUrl(id)}>{titleOf(id)}</a>
                <span class="dims">
                  {maps.get(id)?.dimensions.width}×
                  {maps.get(id)?.dimensions.height}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>

  <p class="back"><a href={url("/")}>← All chapters</a></p>
</Base>

<style>
  /* The chapter's own H1 duplicates the masthead, which already renders fm.title. */
  .prose :global(h1) {
    display: none;
  }
  .prose :global(h2) {
    margin-top: 2.4rem;
  }
  .prose :global(h3) {
    color: var(--fg);
    font-size: 1rem;
    margin-top: 1.8rem;
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 68ch;
  }
  .prose :global(em) {
    color: var(--fg-faint);
    font-style: normal;
    font-size: 0.88em;
    display: inline-block;
    margin-top: 0.2rem;
  }
  .prose :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--rule-hot);
    color: var(--fg-dim);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 2px solid var(--rule);
    margin: 2.5rem 0;
  }
  /* Sections carry an id so a step can be linked to, and a top rule so the walk reads as a
     sequence of places rather than one long list. */
  .walk + .walk {
    margin-top: 2.6rem;
  }
  .walk .note {
    color: var(--fg-dim);
    max-width: 68ch;
  }
  .technote {
    margin-top: 3rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--fg-faint);
    max-width: 68ch;
  }
  .rail {
    position: sticky;
    top: 4.5rem;
    display: grid;
    gap: 1rem;
  }
  .rail :global(h1) {
    display: none;
  }
  .rail :global(h2) {
    font-size: 0.95rem;
    margin: 1.2rem 0 0.4rem;
    color: var(--accent);
  }
  .rail :global(h2::after) {
    display: none;
  }
  .rail :global(p) {
    font-size: 0.9rem;
  }
  .maplist ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }
  .maplist li {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.28rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .maplist li:last-child {
    border-bottom: 0;
  }
  .dims {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
  }
  .back {
    margin-top: 3rem;
  }
</style>
