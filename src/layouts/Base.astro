---
import "../styles/Guide.css";
import { url } from "../Url";
interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
}
const { title, eyebrow, subtitle } = Astro.props;
const commit: string = (await import("../../data/generated/maps.json")).default.game_commit ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Pokémon World Guide</title>
    <meta name="description" content={subtitle ?? "A complete strategy guide for Pokémon World."} />
  </head>
  <body>
    <header class="banner">
      <a class="mark" href={url("/")}>Pokémon World</a>
      <nav>
        <a href={url("species/")}>Pokédex</a>
        <a href={url("items/")}>Items</a>
        <a href={url("gyms/")}>Gyms</a>
        <button id="reveal-all" type="button">Reveal everything</button>
      </nav>
    </header>

    <div class="wrap">
      <div class="masthead">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {subtitle && <p class="sub">{subtitle}</p>}
      </div>
      <slot />
    </div>

    <footer class="site">
      <p>
        Generated from <code>{commit.slice(0, 8)}</code>. Non-commercial fan project, ad-free. No
        ROM or build artifacts are distributed. Pokémon is a trademark of Nintendo, Creatures Inc.
        and GAME FREAK Inc. Not affiliated with or endorsed by Nintendo.
      </p>
    </footer>

    <script>
      const b = document.getElementById("reveal-all");
      const on = () => localStorage.getItem("pw-reveal-all") === "1";
      const sync = () => (b!.textContent = on() ? "Hide spoilers" : "Reveal everything");
      sync();
      b?.addEventListener("click", () => {
        localStorage.setItem("pw-reveal-all", on() ? "0" : "1");
        if (on()) document.dispatchEvent(new CustomEvent("pw:reveal-all"));
        else location.reload();
        sync();
      });
    </script>
  </body>
</html>
