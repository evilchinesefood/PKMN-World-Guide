---
import "../styles/Guide.css";
import { url } from "../Url";
interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
}
const { title, eyebrow, subtitle } = Astro.props;
const commit: string =
  (await import("../../data/generated/maps.json")).default.game_commit ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Pokémon World Guide</title>
    <meta
      name="description"
      content={subtitle ?? "A complete strategy guide for Pokémon World."}
    />
  </head>
  <body>
    <header class="banner">
      <a class="mark" href={url("/")}>Pokémon World</a>
      <nav>
        <a href={url("maps/")}>Maps</a>
        <a href={url("species/")}>Pokédex</a>
        <a href={url("items/")}>Items</a>
        <a href={url("gyms/")}>Gyms</a>
        <a href={url("features/")}>Features</a>
        <button id="reveal-all" type="button">Reveal everything</button>
      </nav>
    </header>

    <div class="wrap">
      <div class="masthead">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {subtitle && <p class="sub">{subtitle}</p>}
      </div>
      <slot />
    </div>

    <footer class="site">
      <p>
        Generated from <code>{commit.slice(0, 8)}</code>. Non-commercial fan
        project, ad-free. No ROM or build artifacts are distributed. Pokémon is
        a trademark of Nintendo, Creatures Inc. and GAME FREAK Inc. Not
        affiliated with or endorsed by Nintendo.
      </p>
      {
        /* Both halves of the project, because neither is much use alone: the commit named
           above is a commit in the GAME repo, and the extractors that read it are in the
           GUIDE repo. Both are external, so tools/qa/Links.mjs does not check them -- if
           either ever moves, nothing here will notice. */
      }
      <p class="sources">
        <a href="https://github.com/evilchinesefood/PKMN-World-Guide"
          >Guide source</a
        >
        <a href="https://github.com/evilchinesefood/PKMN-World">Game source</a>
      </p>
      <a
        class="credit"
        href="https://jdayers.com"
        target="_blank"
        rel="noopener"
      >
        &gt; made with <span class="heart">&#10084;</span> by david ayers<span
          class="cursor">_</span
        >
      </a>
    </footer>

    <script>
      // The banner is sticky at top:0, so anything else that sticks has to start below it --
      // and its height is not a constant. It wraps: 49px on a desktop, 126px at 390px where
      // the mark and six nav controls take three rows, and M5 adding a nav item moves it
      // again. A hard-coded offset would put a chapter's sticky map behind the banner on a
      // phone, so the height is published as a custom property and read by whoever needs it.
      // ResizeObserver, not `resize`: the banner also changes height when the display font
      // finishes loading, which fires no resize event.
      // A browser without ResizeObserver leaves the property unset and every consumer falls
      // back to the desktop constant in CSS -- worth the four characters, since the fallback
      // is otherwise a branch nothing ever takes.
      const banner =
        typeof ResizeObserver === "function"
          ? document.querySelector(".banner")
          : null;
      if (banner)
        new ResizeObserver(() =>
          document.documentElement.style.setProperty(
            "--banner-h",
            `${banner.getBoundingClientRect().height}px`,
          ),
        ).observe(banner);
    </script>

    <script>
      const b = document.getElementById("reveal-all");
      const on = () => localStorage.getItem("pw-reveal-all") === "1";
      const sync = () =>
        (b!.textContent = on() ? "Hide spoilers" : "Reveal everything");
      sync();
      b?.addEventListener("click", () => {
        const next = !on();
        localStorage.setItem("pw-reveal-all", next ? "1" : "0");
        document.dispatchEvent(
          new CustomEvent(next ? "pw:reveal-all" : "pw:hide-all"),
        );
        sync();
      });
    </script>
  </body>
</html>
