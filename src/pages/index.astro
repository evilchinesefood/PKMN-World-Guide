---
// The front of the guide. It used to be the map atlas; the atlas moved to /maps so that the
// first thing a reader sees is what to do, not 1,195 links. Nothing here links to a map page.
import Base from "../layouts/Base.astro";
import { url } from "../Url";
import { chapterEntries, slugOfPath } from "../Chapters";
import mapsData from "../../data/generated/maps.json";
import manifestData from "../../data/manifest/map-manifest.json";

const have = new Set((manifestData as any).maps.map((m: any) => m.map_id));
const live = (mapsData as any).maps.filter((m: any) => have.has(m.id));
const mapCount = live.length.toLocaleString("en-US");

// Play order across the game, and the order the region groups appear in. Anything with an
// unrecognised region sorts after these, alphabetically, so the page never depends on
// filesystem order.
const REGIONS = [
  { key: "kanto", label: "Kanto" },
  { key: "johto", label: "Johto" },
  { key: "hoenn", label: "Hoenn" },
];
const LAST = Number.MAX_SAFE_INTEGER;

// Which content files are chapters is src/Chapters.ts' job -- Insider Tips companions
// (companion_to) and Technical notes (technical_to) are not, and re-deciding that here is how
// the two lists drift.
const chapters = chapterEntries()
  .map(([p, mod]: [string, any]) => {
    const fm = mod.frontmatter ?? {};
    // `Number(null)` is 0, and 0 is finite, so a chapter written with an empty `order:` used
    // to sort AHEAD of `order: 1` instead of falling to the end. Nullish is rejected first.
    const order =
      fm.order == null || (typeof fm.order === "string" && !fm.order.trim())
        ? NaN
        : Number(fm.order);
    return {
      path: p,
      href: url("walkthrough/" + slugOfPath(p) + "/"),
      title: fm.title ?? p,
      region: String(fm.region ?? "").toLowerCase(),
      summary: fm.summary ?? "",
      maps: (fm.maps ?? []).length,
      // A chapter with no `order` falls to the end of its region rather than jumping the
      // queue, and ties break on the file path so the list is stable build to build.
      order: Number.isFinite(order) ? order : LAST,
    };
  })
  .sort((a, b) => a.order - b.order || a.path.localeCompare(b.path));

const known = new Set(REGIONS.map((r) => r.key));
const groups = [
  ...REGIONS,
  ...[...new Set(chapters.map((c) => c.region))]
    .filter((r) => !known.has(r))
    .sort()
    .map((r) => ({
      key: r,
      label: r ? r.replace(/^./, (c) => c.toUpperCase()) : "Elsewhere",
    })),
]
  .map((r) => ({ ...r, chapters: chapters.filter((c) => c.region === r.key) }))
  .filter((r) => r.chapters.length > 0);

// `groups` is already filtered to regions that have a chapter, in play order, so its first
// entry is where the walkthrough opens and its length answers "is this the only one". Both are
// read straight off the content rather than asserted in prose -- see the note by the panel.
const started = groups[0] ?? null;
// Built as one string rather than as markup around a conditional: an expression on its own line
// keeps the newline in front of it, and this sentence's conditional half starts with a comma, so
// the page rendered "walkthrough starts , and so far".
const pickLine = `it is where this guide's walkthrough starts${
  groups.length === 1 ? ", and so far the only region with a written chapter" : ""
}.`;
---

<Base
  title="Pokémon World"
  eyebrow="Complete Strategy Guide"
  subtitle={`Kanto, Johto and Hoenn in one game — ${mapCount} maps, generated from the game's own source.`}
>
  <div class="panel start">
    <span class="label">Start here</span>
    <p>
      <strong>A new game does not begin in a bedroom.</strong> You open your eyes
      in the <strong>World Transit hub</strong>, standing on a departure
      concourse.
    </p>
    <p>
      Four attendants are lined up in front of you. Three of them — Kanto, Johto
      and Hoenn — send you straight to that region as soon as you talk to them,
      and <strong>none of the three is locked</strong>. You really can pick any
      of them on your very first turn. The fourth attendant guards the Battle
      Frontier, and that one <em>is</em> locked for now.
    </p>
    {
      /* The qualifier is real: CannotUseHubReturnHere() blocks the Hub Pass in the Safari
         Zone, the Bug Contest, link and union rooms, and Frontier or Trainer Hill runs. None
         of them is reachable on turn one, which is why the unqualified sentence survived this
         long -- but a guide that tells a reader they can always leave, and then cannot, has
         told them something false at the moment it matters. */
    }
    <p>
      Whichever one you choose also hands you a key item that warps you back to
      the hub whenever you want, so you are never stuck in the region you
      picked — though not from inside the Safari Zone, the Bug Contest, a link
      room or a Battle Frontier run.
    </p>
    {
      /* Both halves of this recommendation used to be hand-written prose that the second
         chapter falsifies, silently, on the homepage -- deferred B6. "Kanto" is now the region
         holding the guide's first chapter, and "the only one with a written chapter" is only
         claimed while `groups` says so. `groups` is already filtered to regions that have at
         least one chapter, so its first entry is the one the walkthrough opens in. */
    }
    {
      started && (
        <p class="pick">
          <strong>Pick {started.label} first</strong> — {pickLine}
        </p>
      )
    }
    <p class="warn">
      One thing to know before you start hopping between regions: crossing a
      region gate puts <strong>your whole team into the PC</strong>. On a brand
      new save that costs you nothing, because you do not have a team yet. Turn
      up later with six Pokémon you love and you will step off the other side
      with none of them.
    </p>
  </div>

  {
    groups.length > 0 && (
      <>
        <h2>The Walkthrough</h2>
        <p class="lede">
          Chapters run in play order. Start at the top of Kanto and work down.
        </p>
        {groups.map((g) => (
          <section class="chapgroup">
            <h3>{g.label}</h3>
            <ol class="chapters">
              {g.chapters.map((c) => (
                <li>
                  <a href={c.href}>{c.title}</a>
                  {c.summary && <p class="what">{c.summary}</p>}
                  <span class="meta">{c.maps} maps</span>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </>
    )
  }

  <h2>Look something up</h2>
  <ul class="refs">
    <li>
      <a href={url("maps/")}>All maps</a>
      <span>
        Every one of the {mapCount} maps, with its aerial view, wild Pokémon, trainers
        and items.
      </span>
    </li>
    <li>
      <a href={url("species/")}>Pokédex</a>
      <span>Every Pokémon in this build, and where to get one.</span>
    </li>
    <li>
      <a href={url("items/")}>Items</a>
      <span>What each item does and what it costs.</span>
    </li>
    <li>
      <a href={url("gyms/")}>Gyms</a>
      <span>All 24 gym leaders, their teams, and their harder rematches.</span>
    </li>
    <li>
      <a href={url("features/")}>Features</a>
      <span>
        Everything this game does that a normal Pokémon game does not — and what
        is not switched on yet.
      </span>
    </li>
  </ul>

  <p class="colophon">
    Every page here is generated from the game repository, so it stays correct
    across releases. Nothing is hand-written except judgement — walkthrough
    pacing, strategy and editorial voice.
  </p>

  <style>
    .lede,
    .colophon {
      max-width: 68ch;
    }
    /* The panel is sized to its text rather than to the page: a 1180px box with a 68ch
       paragraph in it reads as an empty box with writing in the corner. */
    .start {
      max-width: 74ch;
      margin: 0 0 1rem;
    }
    .start p {
      max-width: 68ch;
      margin: 0 0 0.8rem;
    }
    .start p:last-child {
      margin-bottom: 0;
    }
    .start .pick {
      color: var(--fg);
      border-left: 3px solid var(--accent);
      padding-left: 0.8rem;
    }
    .start .warn {
      color: var(--fg-dim);
      font-size: 0.94rem;
    }
    .chapgroup h3 {
      margin-top: 1.6rem;
    }
    .chapters {
      margin: 0;
      padding: 0 0 0 2.4rem;
      display: grid;
      gap: 0.15rem;
    }
    .chapters li {
      border-bottom: 1px solid var(--rule);
      padding: 0.6rem 0;
    }
    .chapters li::marker {
      font-family: var(--mono);
      color: var(--accent);
    }
    .chapters a {
      font: 700 1.05rem/1.2 var(--display);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .chapters .what {
      max-width: 60ch;
      margin: 0.25rem 0 0;
      color: var(--fg-dim);
      font-size: 0.94rem;
    }
    .chapters .meta {
      display: block;
      margin-top: 0.25rem;
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--fg-faint);
    }
    .refs {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
      gap: 0.15rem 1.6rem;
    }
    .refs li {
      border-bottom: 1px solid var(--rule);
      padding: 0.55rem 0;
    }
    .refs a {
      font: 700 0.95rem/1.2 var(--display);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .refs span {
      display: block;
      color: var(--fg-faint);
      font-size: 0.88rem;
      margin-top: 0.15rem;
    }
    .colophon {
      margin-top: 3rem;
      color: var(--fg-faint);
      font-size: 0.88rem;
    }
  </style>
</Base>
