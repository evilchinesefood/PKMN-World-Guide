---
// Leaflet CRS.Simple viewer, per brief decision 6. Every marker coordinate is LOCAL to
// this map, in blocks -- never global. That matters because 49 layouts are shared by 277
// maps, so one image backs up to 18 different maps with different events on it.
//
// Coordinate math (this is the thing M1 exists to prove):
//   image is block_width*16 x block_height*16 px, placed at bounds [[-h,0],[0,w]]
//   a block at (x, y) has its CENTRE at pixel (x*16+8, y*16+8)
//   CRS.Simple latitude increases upward, so lat = -(y*16+8), lng = x*16+8
//
// A page may hold MANY viewers -- a walkthrough chapter draws one per section -- so the
// element id comes from the caller, the script binds every `.pw-viewer` on the page, and
// each instance mounts only when it scrolls into view. Nine Leaflet maps built eagerly is
// a real cost, and a map built while its box is off-screen sizes itself wrong anyway.
import "leaflet/dist/leaflet.css";

interface Props {
  image: string;
  pixelWidth: number;
  pixelHeight: number;
  blockWidth: number;
  blockHeight: number;
  markers: unknown;
  // Unique within the page. The default keeps the single-viewer map pages exactly as they
  // were.
  id?: string;
  // id of an element holding an `<ol class="steps">`. Its `li[data-step][data-at]` become
  // numbered pins, read straight off the DOM -- see the markup contract in Guide.css.
  //
  // PASS null WHEN NO STEP IN THAT LIST CARRIES A COORDINATE. It is what draws the "1
  // Walkthrough step" entry in the legend, and a section whose steps are all uncoordinated
  // draws no pins -- so setting it there captions the map with a key to a symbol that is not
  // on it. Only the caller knows, because only the caller has the steps; passing null also
  // drops the empty "Numbered steps" row from the layer control, which is the same lie in the
  // other control.
  steps?: string | null;
  // Inline in a chapter: shorter, so nine of them do not make a mile-long page.
  compact?: boolean;
  // The map's printed name. Only used to describe the no-JS still below, so it is optional:
  // an unnamed viewer degrades to alt="", which is the correct alt for an image a sighted
  // reader is getting no caption for either.
  label?: string;
}
const {
  image,
  pixelWidth,
  pixelHeight,
  blockWidth,
  blockHeight,
  markers,
  id = "map",
  steps = null,
  compact = false,
  label = "",
} = Astro.props;
---

<div class="viewer">
  <div
    id={id}
    class:list={["pw-viewer", compact && "compact"]}
    style={`--ar:${pixelWidth} / ${pixelHeight}`}
    data-image={image}
    data-w={pixelWidth}
    data-h={pixelHeight}
    data-bw={blockWidth}
    data-bh={blockHeight}
    data-markers={JSON.stringify(markers)}
    data-steps={steps ?? undefined}
  >
  </div>
  {
    /* WITH JAVASCRIPT OFF THE VIEWER NEVER MOUNTS, and the box above is sized by its own
       aspect ratio whether or not anything ever fills it -- so a chapter reserved nine
       780x480 voids, about 4,300px of nothing, between prose the reader could otherwise
       follow. The still is the map: the same PNG Leaflet would have tiled in, already built
       and already deployed, so this costs a request only for the readers who get nothing
       today. Inside <noscript> it is not fetched at all when the script does run.
       Base.astro carries the one rule that hides the empty box, since it must apply once per
       page rather than once per viewer. */
  }
  <noscript>
    <img
      class="pw-static"
      src={image}
      width={pixelWidth}
      height={pixelHeight}
      alt={label ? `Aerial map of ${label}` : ""}
      loading="lazy"
      decoding="async"
    />
  </noscript>
  <ul class="legend">
    {
      steps && (
        <li>
          <i class="k-step">1</i>Walkthrough step
        </li>
      )
    }
    <li><i class="k-item"></i>Ground item</li>
    <li><i class="k-hidden"></i>Hidden item</li>
    <li><i class="k-trainer"></i>Trainer</li>
    <li><i class="k-warp"></i>Warp</li>
    <li><i class="k-sign"></i>Sign</li>
  </ul>
</div>

<style>
  .viewer {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
  /* Height follows the map's own aspect ratio so a tall narrow route does not sit in a
     letterboxed void, clamped so a 170x160 map still fits the screen. */
  /* `min-width: 0` is load-bearing, not tidying. A grid item with an aspect-ratio and a
     min-height takes an automatic minimum WIDTH transferred through the ratio, so an
     unmounted Route 22 box (48x24 blocks, ratio 2) claimed 2 x 18rem = 576px inside a 390px
     phone -- and every viewer is unmounted on first paint, and stays unmounted forever with
     JavaScript off. The page scrolled sideways and the prose beside it was clipped
     mid-sentence. Leaflet sizes itself from the box once it mounts, so this only ever
     mattered before it did, which is exactly when a reader is first looking at the page. */
  .pw-viewer {
    /* Leaflet gives its control corners `z-index: 1000` and `.leaflet-container` itself is
       only `position: relative` with no z-index, so those controls land in the ROOT
       stacking context and outrank anything the page layers above them -- including the
       banner at 500. A zoom button was measured painting over, and taking the tap for, the
       "Items" row of the open nav panel on a map page. `isolation` makes this element a
       stacking context, so Leaflet's 1000 is scoped to the map it belongs to and stops
       competing with the site's chrome. Cheaper and less brittle than out-bidding it.
       The walkthrough's `.walk-map` set `z-index: 2` for the same reason; this fixes the
       cause rather than each symptom. */
    isolation: isolate;
    aspect-ratio: var(--ar, 4 / 3);
    max-height: 78vh;
    min-height: 22rem;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    background: var(--ink-2, #10131a);
    border: 1px solid var(--rule, #8884);
  }
  /* The no-JS still. Bounded the same way the live viewer is, so a 100-block-wide route
     does not blow the column open on a phone. */
  .pw-static {
    display: block;
    width: 100%;
    height: auto;
    max-height: 78vh;
    object-fit: contain;
    border: 1px solid var(--rule, #8884);
    background: var(--ink-2, #10131a);
  }
  /* Inline in a chapter the map is one element of a section, not the whole page. */
  .pw-viewer.compact {
    max-height: 30rem;
    min-height: 18rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }
  .legend i {
    width: 0.85em;
    height: 0.85em;
    border-radius: 50%;
    border: 1.5px solid #fff8;
  }
  .k-item {
    background: #f2b632;
  }
  .k-hidden {
    background: #9a6ef0;
  }
  .k-trainer {
    background: #e2553d;
  }
  .k-warp {
    background: #35a7d8;
  }
  .k-sign {
    background: #7f8a99;
  }
  /* the legend's own miniature of the step pin */
  .k-step {
    display: grid;
    place-items: center;
    width: 1.25em;
    height: 1.25em;
    border: 1.5px solid var(--ink, #0d1210);
    background: var(--accent, #f2b632);
    color: var(--ink, #0d1210);
    font: 800 0.66em/1 var(--mono, monospace);
    font-style: normal;
  }
  :global(.pw-pin) {
    border-radius: 50%;
    border: 1.5px solid #fff;
    box-shadow: 0 0 0 1px #0008;
  }
  /* The step pin, drawn to match .callout-n: amber disc, dark numeral, ring. It is bigger
     than an event dot and carries real text, so it reads as the primary layer even though
     amber is also the ground-item colour. */
  :global(.pw-step) {
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--accent, #f2b632);
    color: var(--ink, #0d1210);
    font: 800 0.85rem/1 var(--mono, monospace);
    border: 2px solid var(--ink, #0d1210);
    box-shadow:
      0 0 0 1.5px #ffffffcc,
      0 2px 6px #000a;
  }
  :global(.leaflet-container) {
    background: #10131a;
    font: inherit;
  }

  /* Leaflet's own rule for a map with both drag and pinch enabled is `touch-action: none`,
     which forbids the BROWSER from scrolling at all -- so a thumb landing on a map stops
     the page dead. Disabling dragging on a coarse pointer already leaves Leaflet's
     `pan-x pan-y`, but a touchscreen laptop reports a fine pointer and keeps dragging, so
     the vendor rule is overridden for that case too. !important because this has to beat
     `.leaflet-container.leaflet-touch-drag.leaflet-touch-zoom` whatever order the two
     stylesheets end up bundled in. One finger scrolls; two fingers still reach Leaflet. */
  :global(.leaflet-container.leaflet-touch-drag),
  :global(.leaflet-container.leaflet-touch-drag.leaflet-touch-zoom) {
    touch-action: pan-x pan-y !important;
  }

  /* On paper the dark box is the problem, not the design. Three things go wrong printing a
     lazily mounted map, so all three are handled:
       - a viewer that never mounted (JS off, or a browser that skips beforeprint) is an
         empty rectangle -- 3,750px of it on this chapter -- so it is removed entirely,
         along with the legend that would otherwise caption nothing;
       - a viewer that mounted but whose image is still in flight would print the dark
         background, so the background goes white and the worst case is blank paper;
       - the map art itself is framed for a white page. */
  @media print {
    .pw-viewer:not(.leaflet-container) {
      display: none;
    }
    .viewer:has(.pw-viewer:not(.leaflet-container)) .legend {
      display: none;
    }
    .pw-viewer,
    :global(.leaflet-container) {
      background: #fff;
      border-color: #000;
    }
  }
</style>

<script>
  import L from "leaflet";

  const COLOR: Record<string, string> = {
    item: "#f2b632",
    hidden_item: "#9a6ef0",
    trainer: "#e2553d",
    warp: "#35a7d8",
    sign: "#7f8a99",
  };

  // A phone or tablet, where the primary pointer is a finger and there is no drag-to-pan
  // that does not also mean "scroll the page".
  const COARSE =
    typeof matchMedia === "function" && matchMedia("(pointer: coarse)").matches;

  const NAMES: Record<string, string> = {
    item: "Ground items",
    hidden_item: "Hidden items",
    trainer: "Trainers",
    warp: "Warps",
    sign: "Signs",
  };

  // The pin's number is READ from the step, never recomputed. `data-step` is what the CSS
  // badge prints with attr(), so taking the same attribute is the only way the numeral on
  // the map and the numeral beside the sentence cannot drift apart.
  function stepPins(el: HTMLElement) {
    const host = el.dataset.steps
      ? document.getElementById(el.dataset.steps)
      : null;
    if (!host) return null;
    const g = L.layerGroup();
    const items: { marker: L.Marker; at: L.LatLng }[] = [];
    for (const li of host.querySelectorAll<HTMLElement>(
      "li[data-step][data-at]",
    )) {
      const [x, y] = (li.dataset.at || "").split(",").map(Number);
      if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
      // textContent, not innerHTML: the numeral is text, never markup from content.
      const num = document.createElement("b");
      num.textContent = li.dataset.step!;
      const text = (li.textContent || "").replace(/\s+/g, " ").trim();
      const label = text.length > 96 ? text.slice(0, 95) + "…" : text;
      // An ELEMENT, not a string. `bindTooltip(String)` assigns through innerHTML, which
      // quietly breaks the textContent invariant the comment twelve lines above states and
      // the numeral obeys. Not exploitable -- every step is repo-authored -- but a step
      // whose sentence contains `<` renders wrong, and a chapter that says "walk to the <
      // shaped rock" would lose the rest of its sentence with no error anywhere.
      const tip = document.createElement("span");
      tip.textContent = label;
      const at = L.latLng(-(y * 16 + 8), x * 16 + 8);
      const marker = L.marker(at, {
        icon: L.divIcon({
          className: "pw-step",
          html: num,
          iconSize: [26, 26],
          iconAnchor: [13, 13],
        }),
        riseOnHover: true,
        // NOT keyboard-reachable, deliberately. Leaflet's default puts every marker in the
        // tab order as `role="button"` named by its own icon text, so a chapter handed a
        // keyboard user 37 stops announced "3, button" -- and each one only scrolls to a step
        // that is already the next thing in the document. The steps are an <ol> right below
        // the map with the same numeral and the same sentence, reachable in reading order, so
        // the pins duplicate content that is already there and add only POSITION, which a tab
        // stop cannot convey anyway.
        keyboard: false,
      })
        .bindTooltip(tip, { direction: "top", offset: [0, -12] })
        // Named for the readers who DO meet it: a pin is still in the accessibility tree, and
        // a bare "3" is not a description of anything. `aria-label` rather than `title` --
        // `title` would raise a second, native tooltip beside Leaflet's own on hover.
        // On `add`, because getElement() is null until the marker is on the map.
        .on("add", (e: any) => {
          const el = e.target.getElement() as HTMLElement | null;
          if (!el) return;
          el.setAttribute("role", "img");
          el.setAttribute("aria-label", `Step ${li.dataset.step}: ${label}`);
        })
        // Put the step's TOP just under the map, rather than its bottom against the foot of
        // the viewport.
        //
        // Neither of the two obvious answers works. `center` puts the step behind the sticky
        // map, since the middle of the viewport IS the map. `end` is right only while the
        // step fits the band the map leaves: at 390px Route 1's band is 158px and its steps
        // run to 226px, so `end` pushed 92px of step -- including its numbered badge, which
        // is the entire pin-to-step pairing -- up behind the opaque map. The reader clicked
        // pin 3 and lost the numeral 3.
        //
        // The map's position AFTER the scroll is predicted, not read: its current rect
        // describes where it is before the scroll, not where it will be. Stuck, its bottom is
        // its own resolved sticky offset plus its height -- `getComputedStyle().top` rather
        // than a copy of `--banner-h`, so the script cannot disagree with the stylesheet
        // about where the map stops. If it turns out NOT to be stuck the step still lands
        // below it, because a step always follows its map in the document, so one prediction
        // covers both cases with no branch for "will it stick".
        .on("click", () => {
          const fig = li.closest("section")?.querySelector("figure.walk-map");
          const cs = fig && getComputedStyle(fig);
          // No sticky map: a map page, a viewport too small to stick in, or an engine without
          // `:has()`. `end`, NOT `start` -- with the map ahead of the step in the document,
          // `start` puts the step under the banner and scrolls the map completely off the top,
          // every time. Measured: it landed 37 of 37 pin clicks with zero map on screen, where
          // even the `center` it replaced managed 24 to 33. `end` gives the map the whole
          // viewport above the step instead of half of it, so it beats `center` too.
          if (!cs || cs.position !== "sticky")
            return li.scrollIntoView({ block: "end", behavior: "smooth" });
          // Backstop for a window too short to hold both: never scroll the step off the
          // bottom of the screen. The CSS above already unsticks the map at the sizes where
          // that is reachable, so this only covers shapes the media query does not name --
          // a 300px-high desktop window. Showing the step partly under the map is bad;
          // showing nothing at all after a click is worse.
          const clear = Math.max(
            0,
            Math.min(
              parseFloat(cs.top) + (fig as HTMLElement).offsetHeight + 12,
              innerHeight - Math.min(li.offsetHeight, 64),
            ),
          );
          scrollTo({
            top: li.getBoundingClientRect().top + scrollY - clear,
            behavior: "smooth",
          });
        })
        .addTo(g);
      items.push({ marker, at });
    }
    return items.length ? { group: g, items } : null;
  }

  // A step pin is a 26px disc, and at the zoom that fits a whole city onto a phone a map
  // tile is under 7px, so two steps on ADJACENT TILES draw one numeral on top of the other:
  // Viridian's 8/9 and 13/14 measured 7px apart, and a reader following step 13 could not
  // find it. The pins are nudged apart until each numeral is clear of its neighbour's disc
  // and no further.
  //
  // SEP is where the covering stops, not a comfortable gap: half a disc plus half a numeral.
  // Pairs already further apart than that -- Oak's three starter balls at 23px, adjacent by
  // design -- are left exactly where they are.
  //
  // TILE is the rule this obeys before it obeys SEP. A pin that is easy to read but on the
  // wrong tile is worse than one that overlaps, so no pin moves further than one tile from
  // the step it numbers; where a zoom is too coarse to buy SEP within that budget the pins
  // stay touching, which is what they do today, and zooming in still separates them for
  // real. How close two tiles LOOK is a property of the zoom, so this re-runs on zoom rather
  // than being baked in once.
  const SEP = 20;
  const TILE = 16;

  function declutter(map: L.Map, items: { marker: L.Marker; at: L.LatLng }[]) {
    const pts = items.map((p) => map.latLngToLayerPoint(p.at));
    const tile =
      map.latLngToLayerPoint(L.latLng(0, TILE)).x -
      map.latLngToLayerPoint(L.latLng(0, 0)).x;
    const off = items.map(() => ({ x: 0, y: 0 }));
    // Pairwise relaxation: every overlapping pair pushes both of its pins apart by half the
    // shortfall, repeatedly, so a cluster of three settles as readily as a pair. Fixed
    // iteration order and a fixed fallback angle for exactly coincident pins keep it
    // deterministic -- the same map draws the same pins every time.
    for (let pass = 0; pass < 24; pass++) {
      let moved = false;
      for (let i = 0; i < items.length; i++)
        for (let j = i + 1; j < items.length; j++) {
          let dx = pts[j].x + off[j].x - pts[i].x - off[i].x;
          let dy = pts[j].y + off[j].y - pts[i].y - off[i].y;
          let d = Math.hypot(dx, dy);
          if (d >= SEP) continue;
          if (d < 1e-6) {
            dx = Math.cos(i * 2.399);
            dy = Math.sin(i * 2.399);
            d = 1;
          }
          const push = (SEP - d) / 2;
          off[i].x -= (dx / d) * push;
          off[i].y -= (dy / d) * push;
          off[j].x += (dx / d) * push;
          off[j].y += (dy / d) * push;
          moved = true;
        }
      if (!moved) break;
    }
    for (let i = 0; i < items.length; i++) {
      const len = Math.hypot(off[i].x, off[i].y);
      if (len > tile) {
        off[i].x *= tile / len;
        off[i].y *= tile / len;
      }
      items[i].marker.setLatLng(
        map.layerPointToLatLng(
          L.point(pts[i].x + off[i].x, pts[i].y + off[i].y),
        ),
      );
    }
  }

  function init(el: HTMLElement) {
    const w = +el.dataset.w!;
    const h = +el.dataset.h!;
    const markers = JSON.parse(el.dataset.markers || "[]");

    const map = L.map(el, {
      crs: L.CRS.Simple,
      minZoom: -3,
      maxZoom: 3,
      zoomSnap: 0.25,
      attributionControl: false,
      // The page's scroll belongs to the page, on every kind of map. A chapter stacks nine
      // maps down 12,000px and a map page keeps its encounters and trainers below the fold,
      // so a map that eats the wheel traps the reader on the way past -- and silently zooms
      // the thing they were reading. Zoom is the +/- control (always drawn, top left),
      // double-click, shift-drag and pinch: all deliberate acts, none of them a scroll.
      scrollWheelZoom: false,
      // The same rule for a thumb. Leaflet's drag handler makes a one-finger drag pan the
      // map and sets touch-action so the browser cannot scroll instead, which on a phone
      // means a map you cannot get past. Off for touch: one finger scrolls the page, two
      // fingers pan and pinch (touchZoom moves the centre as well as zooming). A mouse
      // keeps drag-to-pan.
      dragging: !COARSE,
    });

    // y is negated so block row 0 sits at the TOP, matching how the image reads.
    const bounds = L.latLngBounds([-h, 0], [0, w]);
    L.imageOverlay(el.dataset.image!, bounds, { className: "pw-map" }).addTo(
      map,
    );
    map.fitBounds(bounds);
    map.setMaxBounds(bounds.pad(0.25));

    const layers: Record<string, L.LayerGroup> = {};
    for (const m of markers) {
      const g = (layers[m.kind] ||= L.layerGroup().addTo(map));
      // block (x,y) -> centre of that 16px tile
      L.circleMarker([-(m.y * 16 + 8), m.x * 16 + 8], {
        radius: 5,
        weight: 1.5,
        color: "#fff",
        fillColor: COLOR[m.kind] || "#ccc",
        fillOpacity: 0.95,
        className: "pw-pin",
      })
        .bindTooltip(
          `${m.label} <span style="opacity:.6">(${m.x}, ${m.y})</span>`,
          {
            direction: "top",
          },
        )
        .addTo(g);
    }

    // Step pins are divIcons, which Leaflet puts in the marker pane -- above the SVG pane
    // the event circles live in. The reader can switch the events off underneath them.
    const pins = stepPins(el);
    if (pins) {
      pins.group.addTo(map);
      const place = () => declutter(map, pins.items);
      place();
      // Both events change how far apart two tiles are on screen, and nothing else does.
      map.on("zoomend", place);
      map.on("resize", place);
    }

    const ctl: Record<string, L.LayerGroup> = {};
    if (pins) ctl["Numbered steps"] = pins.group;
    for (const k of Object.keys(layers)) ctl[NAMES[k] || k] = layers[k];
    // Expanded, the control is six rows. On a phone the inline chapter map is about
    // 342x288 and those six rows sit on top of the middle of it -- the map is the page, so
    // the control collapses to its button there and opens on a tap. Unchanged on a mouse.
    L.control.layers(undefined, ctl, { collapsed: COARSE }).addTo(map);
  }

  const viewers = document.querySelectorAll<HTMLElement>(".pw-viewer");
  // Two paths can reach the same element -- the observer and beforeprint -- and Leaflet
  // throws "Map container is already initialized" on the second, so guard it here rather
  // than in each caller.
  const mounted = new WeakSet<HTMLElement>();
  const mount = (el: HTMLElement) => {
    if (mounted.has(el)) return;
    mounted.add(el);
    init(el);
  };

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          mount(e.target as HTMLElement);
        }
      },
      // a screen ahead, so a map is already drawn by the time it is scrolled to
      { rootMargin: "300px" },
    );
    for (const v of viewers) io.observe(v);
  } else {
    for (const v of viewers) mount(v);
  }

  // Printing does not scroll, so on a chapter the reader has just opened only the first
  // map has mounted and the other eight would print as empty boxes. Mount them all before
  // the paper is drawn. The print stylesheet still hides any that did not make it, so a
  // browser that skips this event prints nothing there rather than a black rectangle.
  addEventListener("beforeprint", () => {
    for (const v of viewers) mount(v);
  });

  // Mounting at beforeprint is synchronous, but the overlay's PNG is a fresh network
  // request and the print rasteriser does not wait for it: measured on this chapter, a
  // cold print embedded 41 image objects where a warmed cache embedded 46. Pulling the
  // images into cache once the page is idle closes that exactly, and it costs 227KB for
  // the Kanto chapter -- bytes a reader who scrolls the chapter fetches anyway. The
  // Leaflet instances, which are the cost the lazy mount exists for, stay lazy.
  const prefetch = () => {
    const seen = new Set<string>();
    for (const v of viewers) {
      const src = v.dataset.image;
      if (!src || mounted.has(v) || seen.has(src)) continue;
      seen.add(src);
      new Image().src = src;
    }
  };
  if ("requestIdleCallback" in window)
    requestIdleCallback(prefetch, { timeout: 3000 });
  else addEventListener("load", () => setTimeout(prefetch, 500));
</script>
