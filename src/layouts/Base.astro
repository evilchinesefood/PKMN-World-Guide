---
import "../styles/Guide.css";
import { url } from "../Url";
interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
}
const { title, eyebrow, subtitle } = Astro.props;
const commit: string =
  (await import("../../data/generated/maps.json")).default.game_commit ?? "";

// The GitHub mark (Octicons `mark-github-16`, MIT), inlined because this site loads nothing
// external -- a CDN icon font would be the only third-party request on the page, and it would
// be one the reader waits for to see a 14px glyph. Declared once and drawn twice: the two
// <svg> wrappers differ only in nothing, and the path is the part worth not copying.
// `fill="currentColor"` is what makes the print rule work -- the footer's print override sets
// `color: #000` and the mark follows it without a second rule.
const GITHUB_MARK =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Pokémon World Guide</title>
    <meta
      name="description"
      content={subtitle ?? "A complete strategy guide for Pokémon World."}
    />
    {
      /* An unmounted viewer is an empty box holding its own aspect ratio, and with the script
         off it stays that way forever -- nine of them on a chapter, ~4,300px of nothing. The
         box goes and MapViewer's <noscript> still takes its place. It lives here, once per
         page, because a rule repeated inside nine viewers is the same rule nine times.
         `is:inline` so Astro leaves it in the <noscript> rather than hoisting it into the
         bundle, where it would apply to everyone. */
    }
    <noscript>
      <style is:inline>
        .pw-viewer {
          display: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <header class="banner">
      {
        /* The lid's ornament. Decorative to a screen reader -- the lens says nothing
           and the lamps duplicate state the reveal button already announces in its
           own label, so announcing them again would be noise, not information. */
      }
      <div class="dev-lens" aria-hidden="true"></div>
      <div class="dev-lights" aria-hidden="true">
        <span class="lamp lamp-item"></span>
        <span class="lamp lamp-hidden"></span>
        <span class="lamp lamp-warp"></span>
      </div>
      <a class="mark" href={url("/")}>Pokémon World</a>
      {
        /* Native <details> -- the same disclosure Fold.astro uses. <summary> is focusable,
           toggles on Enter and Space, and reports its own expanded state, so there is no
           aria-expanded to keep in sync.

           SHIPPED OPEN, AND THAT IS THE WHOLE TRICK. The obvious build has it shipped
           closed and forced visible above 700px, and that version is broken on every
           engine older than Chrome 131 / Safari 18.4 / Firefox 143: a closed <details>
           hides its content through the UA's shadow-DOM slot, which author CSS on the
           light-DOM child cannot reach, so `.banner nav { display: flex }` does nothing
           and only `::details-content` works. On Firefox ESR 140, Safari 18.3 and an iPad
           at >700px, that leaves the entire site with no navigation at all.

           Open by default inverts the failure. The content always renders, so no override
           is needed above the breakpoint, and the script below only ever CLOSES it -- on a
           phone, where the summary is visible and native toggling takes over. Lose the
           script and a phone gets the panel already expanded: every link reachable, just
           taller. The degraded state is more nav, never none. */
      }
      <details class="nav-menu" open>
        <summary aria-label="Menu"><span class="bars" aria-hidden="true"></span></summary>
        <nav>
          <a href={url("search/")}>Search</a>
          <a href={url("maps/")}>Maps</a>
          <a href={url("species/")}>Pokédex</a>
          <a href={url("items/")}>Items</a>
          <a href={url("gyms/")}>Gyms</a>
          <a href={url("features/")}>Features</a>
          <button id="reveal-all" type="button">Reveal everything</button>
        </nav>
      </details>
      {
        /* INLINE, and immediately after the element it acts on, because this is the only
           thing that closes the menu and it has to happen during parse. As a module it was
           deferred until after the document finished, and on a throttled phone the panel
           painted OPEN for ~0.9s over the masthead before snapping shut -- worst on exactly
           the biggest pages (/items/, /species/, /maps/), which are the slowest to parse.
           No layout shift either way (the panel overlays, so the banner is 47.4px open or
           closed), but a menu nobody asked for should not be the first thing a reader sees.

           `is:inline` also means Astro ships it verbatim rather than as a TypeScript module,
           so this is plain JS with no cast. */
      }
      <script is:inline>
        (function () {
          var menu = document.querySelector(".nav-menu");
          if (!menu) return;
          var narrow = window.matchMedia("(max-width: 700px)");
          var sync = function () {
            menu.open = !narrow.matches;
          };
          sync();
          // addEventListener on a MediaQueryList postdates Safari 14 and Firefox 55; the
          // older addListener is the same signal. Whichever is missing, sync() has already
          // run, so the worst case is losing the re-open when a window crosses 700px --
          // never a reader left without navigation.
          if (narrow.addEventListener) narrow.addEventListener("change", sync);
          else if (narrow.addListener) narrow.addListener(sync);
        })();
      </script>
    </header>

    <div class="wrap">
      <div class="masthead">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {subtitle && <p class="sub">{subtitle}</p>}
      </div>
      <slot />
    </div>

    <footer class="site">
      <p>
        Generated from <code>{commit.slice(0, 8)}</code>. Non-commercial fan
        project, ad-free. No ROM or build artifacts are distributed. Pokémon is
        a trademark of Nintendo, Creatures Inc. and GAME FREAK Inc. Not
        affiliated with or endorsed by Nintendo.
      </p>
      {
        /* Both halves of the project, because neither is much use alone: the commit named
           above is a commit in the GAME repo, and the extractors that read it are in the
           GUIDE repo. Both are external, so tools/qa/Links.mjs does not check them -- if
           either ever moves, nothing here will notice. */
      }
      <p class="sources">
        <a href="https://github.com/evilchinesefood/PKMN-World-Guide">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d={GITHUB_MARK} />
          </svg>
          Guide source
        </a>
        <a href="https://github.com/evilchinesefood/PKMN-World">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d={GITHUB_MARK} />
          </svg>
          Game source
        </a>
      </p>
      <a
        class="credit"
        href="https://jdayers.com"
        target="_blank"
        rel="noopener"
      >
        &gt; made with <span class="heart">&#10084;</span> by david ayers<span
          class="cursor">_</span
        >
      </a>
    </footer>

    <script>
      // The banner is sticky at top:0, so anything else that sticks has to start below it --
      // and its height is not a constant. It wraps: 49px on a desktop, 126px at 390px where
      // the mark and six nav controls take three rows, and M5 adding a nav item moves it
      // again. A hard-coded offset would put a chapter's sticky map behind the banner on a
      // phone, so the height is published as a custom property and read by whoever needs it.
      // ResizeObserver, not `resize`: the banner also changes height when the display font
      // finishes loading, which fires no resize event.
      // A browser without ResizeObserver leaves the property unset and every consumer falls
      // back to the desktop constant in CSS -- worth the four characters, since the fallback
      // is otherwise a branch nothing ever takes.
      const banner =
        typeof ResizeObserver === "function"
          ? document.querySelector(".banner")
          : null;
      if (banner)
        new ResizeObserver(() =>
          document.documentElement.style.setProperty(
            "--banner-h",
            `${banner.getBoundingClientRect().height}px`,
          ),
        ).observe(banner);
    </script>

    <script>
      const b = document.getElementById("reveal-all");
      const on = () => localStorage.getItem("pw-reveal-all") === "1";
      const sync = () => {
        b!.textContent = on() ? "Hide spoilers" : "Reveal everything";
        // The amber lamp on the lid reports the same state this label does, so it is
        // set from the same place. Two readouts that can drift apart are worse than
        // one. sync() already runs on load as well as on click, so a reader who
        // revealed spoilers last visit finds the lamp lit when the page opens.
        document.documentElement.classList.toggle("pw-revealed", on());
      };
      sync();
      b?.addEventListener("click", () => {
        const next = !on();
        localStorage.setItem("pw-reveal-all", next ? "1" : "0");
        document.dispatchEvent(
          new CustomEvent(next ? "pw:reveal-all" : "pw:hide-all"),
        );
        sync();
      });
    </script>
  </body>
</html>
